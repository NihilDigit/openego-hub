<UserControl
    x:Class="EGoTouchSettings.BatteryIndicator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    UseLayoutRounding="True">

    <UserControl.Resources>
        <SolidColorBrush x:Key="BatteryNormalBrush" Color="{ThemeResource TextFillColorPrimary}" />
        <SolidColorBrush x:Key="BatteryChargingBrush" Color="{ThemeResource SystemFillColorSuccess}" />
        <SolidColorBrush x:Key="BatteryLowBrush" Color="{ThemeResource SystemFillColorCritical}" />
    </UserControl.Resources>

    <!-- 统一几何电池指示器：100% 时内部填满，无字形阶梯留白。全站概览、配件页、
         电池页、快捷面板与接入弹窗共用同一组视觉定义。 -->
    <StackPanel x:Name="IndicatorRoot"
                Orientation="Horizontal"
                Spacing="6"
                VerticalAlignment="Center"
                Visibility="Collapsed">
        <Grid x:Name="BatteryIconGroup"
              VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="BatteryBody"
                    Grid.Column="0"
                    Width="24"
                    Height="12"
                    CornerRadius="3"
                    BorderThickness="1.5"
                    Padding="1.5"
                    BorderBrush="{ThemeResource TextFillColorPrimaryBrush}"
                    Opacity="0.9">
                <Border x:Name="BatteryFillBar"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        CornerRadius="1"
                        Visibility="Collapsed" />
            </Border>
            <Border x:Name="BatteryCap"
                    Grid.Column="1"
                    Width="2"
                    Height="5"
                    Margin="1,0,0,0"
                    CornerRadius="0,1.5,1.5,0"
                    VerticalAlignment="Center"
                    Background="{ThemeResource TextFillColorPrimaryBrush}"
                    Opacity="0.75" />
        </Grid>

        <StackPanel x:Name="BatteryTextGroup"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="1">
            <TextBlock x:Name="BatteryValue"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="BatteryPercentUnit"
                       Text="%"
                       FontSize="11"
                       Margin="0,2,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" />
        </StackPanel>
    </StackPanel>
</UserControl>
