<UserControl
    x:Class="EGoTouchSettings.BatteryIndicator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel x:Name="IndicatorRoot"
                Orientation="Horizontal"
                Spacing="7"
                VerticalAlignment="Center"
                Visibility="Collapsed">
        <!-- PC Manager 在本机可用时显示同一组电量图；下面的 XAML 图形始终留作自有兜底。 -->
        <Grid Width="27" Height="16" VerticalAlignment="Center">
            <Grid x:Name="BatteryFallback" Width="27" Height="16">
                <Border Width="23" Height="13"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        BorderThickness="1.25"
                        BorderBrush="{ThemeResource TextFillColorPrimaryBrush}"
                        CornerRadius="3">
                    <Grid Margin="2">
                        <Border x:Name="BatteryFill"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="1" />
                    </Grid>
                </Border>
                <Border Width="2" Height="7"
                        Margin="0,0,1,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="{ThemeResource TextFillColorPrimaryBrush}"
                        CornerRadius="0,1,1,0" />
                <FontIcon x:Name="ChargingGlyph"
                          Glyph="&#xE945;"
                          FontSize="9"
                          Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Visibility="Collapsed" />
            </Grid>
            <Image x:Name="BatteryImage" Stretch="Uniform" Visibility="Collapsed" />
        </Grid>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="1">
            <TextBlock x:Name="BatteryValue"
                       FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <TextBlock Text="%"
                       FontSize="10"
                       Margin="0,4,0,0"
                       VerticalAlignment="Center" />
        </StackPanel>
    </StackPanel>
</UserControl>
