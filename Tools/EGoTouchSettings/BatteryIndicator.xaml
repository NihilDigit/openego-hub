<UserControl
    x:Class="EGoTouchSettings.BatteryIndicator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- 充电脉冲压在电量条上，而电量条的明暗随主题翻转：深色主题里它是近白，
                     浅色主题里是近黑。所以脉冲的绿要跟它反着走——系统的 SystemFillColorSuccess
                     恰好同向（深色给亮绿、浅色给深绿），照搬会让脉冲在两种主题下都糊在
                     电量条里。Default 即深色。 -->
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="BatteryFillBrush"
                                     Color="{ThemeResource TextFillColorPrimary}" />
                    <SolidColorBrush x:Key="BatteryChargingBrush" Color="#FF107C10" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BatteryFillBrush"
                                     Color="{ThemeResource TextFillColorPrimary}" />
                    <SolidColorBrush x:Key="BatteryChargingBrush" Color="#FF4CC94C" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel x:Name="IndicatorRoot"
                Orientation="Horizontal"
                Spacing="7"
                VerticalAlignment="Center"
                Visibility="Collapsed">
        <!-- 电量图自己画。PC Manager 的那组 PNG 曾经优先于它，但位图的配色是定死的亮绿，
             在深色主题下既刺眼又和周围的文字对不上，而 PNG 改不了颜色。画出来的图形吃
             ThemeResource，深浅两色各自成立。 -->
        <Grid Width="27" Height="16" VerticalAlignment="Center">
            <Border Width="23" Height="13"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    BorderThickness="1.25"
                    BorderBrush="{ThemeResource TextFillColorSecondaryBrush}"
                    CornerRadius="3">
                <Grid Margin="2">
                    <Border x:Name="BatteryFill"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource BatteryFillBrush}"
                            CornerRadius="1" />
                    <!-- 充电时从空扫到满、循环，压在电量条上表示正在往里灌。不做成「电量条
                         自己涨到满」：电量九成以上时那点行程几乎看不出来，而充电恰恰是电量
                         高的时候看得最多。也不再另摆一个闪电图标——两个图标并排读起来是
                         两件事。 -->
                    <Border x:Name="BatteryPulse"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource BatteryChargingBrush}"
                            CornerRadius="1"
                            Opacity="0"
                            Visibility="Collapsed" />
                </Grid>
            </Border>
            <Border Width="2" Height="7"
                    Margin="0,0,1,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="{ThemeResource TextFillColorSecondaryBrush}"
                    CornerRadius="0,1,1,0" />
        </Grid>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="1">
            <TextBlock x:Name="BatteryValue"
                       FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <TextBlock Text="%"
                       FontSize="10"
                       Margin="0,4,0,0"
                       VerticalAlignment="Center" />
        </StackPanel>
    </StackPanel>
</UserControl>
