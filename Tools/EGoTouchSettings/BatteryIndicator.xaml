<UserControl
    x:Class="EGoTouchSettings.BatteryIndicator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel x:Name="IndicatorRoot"
                Orientation="Horizontal"
                Spacing="7"
                VerticalAlignment="Center"
                Visibility="Collapsed">
        <!-- 电量图用 Segoe Fluent Icons 里现成的那一组：Battery0..Battery10 是十一档电量，
             BatteryCharging0..10 是对应的充电态，外框、电量条和闪电都在字形里。字形跟着
             字号缩放、颜色跟前景走，深浅两色不必各调一遍。挑哪一个字形见 SetState。 -->
        <FontIcon x:Name="BatteryGlyph"
                  FontSize="20"
                  Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                  VerticalAlignment="Center" />

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="1">
            <TextBlock x:Name="BatteryValue"
                       FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <TextBlock Text="%"
                       FontSize="10"
                       Margin="0,4,0,0"
                       VerticalAlignment="Center" />
        </StackPanel>
    </StackPanel>
</UserControl>
