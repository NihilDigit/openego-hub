<Window
    x:Class="EGoTouchSettings.NotificationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EGoTouchSettings">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="NotificationRoot" Background="Transparent" Opacity="0">
        <Border x:Name="NotificationCard"
                Padding="16"
                CornerRadius="16"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
            <StackPanel x:Name="ConnectionView" Spacing="12">
                <Grid Height="28">
                    <Image x:Name="PenImage"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
                    <FontIcon x:Name="PenImageFallback"
                              Glyph="&#xE70F;"
                              FontSize="24"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <Grid ColumnSpacing="12" Height="26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PenNameText"
                               Text="HUAWEI M-Pencil"
                               FontSize="14"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <local:BatteryIndicator x:Name="PenBatteryIndicator"
                                            Grid.Column="1"
                                            VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <Grid x:Name="KeyboardConnectionView"
                  Height="66"
                  ColumnSpacing="14"
                  Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="96" Height="66">
                    <Image x:Name="KeyboardImage"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
                    <FontIcon x:Name="KeyboardImageFallback"
                              Glyph="&#xE765;"
                              FontSize="28"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <StackPanel Grid.Column="1"
                            Spacing="10"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="KeyboardNameText"
                               Text="HUAWEI 智能磁吸键盘"
                               FontSize="14"
                               HorizontalAlignment="Right"
                               TextAlignment="Right"
                               TextTrimming="CharacterEllipsis" />
                    <local:BatteryIndicator x:Name="KeyboardBatteryIndicator"
                                            HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>

            <Grid x:Name="DeviationView" ColumnSpacing="12" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE7BA;"
                          FontSize="20"
                          Foreground="{ThemeResource SystemFillColorCautionBrush}"
                          VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="手写笔未正确吸附"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
