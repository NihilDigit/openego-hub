<Window
    x:Class="EGoTouchSettings.NotificationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EGoTouchSettings">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="NotificationRoot" Background="Transparent" Opacity="0">
        <!-- 圆角必须与 DWM 给窗口裁的那一档一致，见 ConfigureWindow 里的说明。
             OverlayCornerRadius 就是那一档，写死数值会在下一次系统改半径时重新错开。
             卡片不描边：窗口的轮廓由 DWM 那条边框画，两条叠在一起就是深色下的双层白边。 -->
        <Border x:Name="NotificationCard"
                Padding="16"
                CornerRadius="{ThemeResource OverlayCornerRadius}">
            <Grid>
            <StackPanel x:Name="ConnectionView" Spacing="12">
                <Grid Height="28">
                    <Image x:Name="PenImage"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
                    <FontIcon x:Name="PenImageFallback"
                              Glyph="&#xE70F;"
                              FontSize="24"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <Grid ColumnSpacing="12" Height="26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PenNameText"
                               Text="HUAWEI M-Pencil"
                               FontSize="14"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <local:BatteryIndicator x:Name="PenBatteryIndicator"
                                            Grid.Column="1"
                                            VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <Grid x:Name="KeyboardConnectionView"
                  Height="66"
                  ColumnSpacing="14"
                  Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="96" Height="66">
                    <Image x:Name="KeyboardImage"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
                    <FontIcon x:Name="KeyboardImageFallback"
                              Glyph="&#xE765;"
                              FontSize="28"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <StackPanel Grid.Column="1"
                            Spacing="10"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="KeyboardNameText"
                               Text="HUAWEI 智能磁吸键盘"
                               FontSize="14"
                               HorizontalAlignment="Right"
                               TextAlignment="Right"
                               TextTrimming="CharacterEllipsis" />
                    <local:BatteryIndicator x:Name="KeyboardBatteryIndicator"
                                            HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>

            <!-- 这一条只有一行字，居中排：连接提示那两张要留出电量和整支笔的位置，靠左才
                 对得齐，这里靠左只会在右边空出半张卡片。 -->
            <StackPanel x:Name="ToolView"
                        Orientation="Horizontal"
                        Spacing="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <!-- 两个字形各摆一个，代码只切可见性：字形写在这里是十六进制实体，
                     写进 .cpp 就成了源码里看不出含义的私有区字符。 -->
                <Grid VerticalAlignment="Center">
                    <FontIcon x:Name="ToolPenIcon"
                              Glyph="&#xE70F;"
                              FontSize="20"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <FontIcon x:Name="ToolEraserIcon"
                              Glyph="&#xE75C;"
                              FontSize="20"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                              Visibility="Collapsed" />
                </Grid>
                <TextBlock x:Name="ToolText"
                           Text="橡皮擦"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Grid x:Name="DeviationView" ColumnSpacing="12" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE7BA;"
                          FontSize="20"
                          Foreground="{ThemeResource SystemFillColorCautionBrush}"
                          VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="手写笔未正确吸附"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
