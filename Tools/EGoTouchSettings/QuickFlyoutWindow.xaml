<Window
    x:Class="EGoTouchSettings.QuickFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EGoTouchSettings">

    <Grid x:Name="FlyoutRoot"
          Background="Transparent"
          Padding="16"
          Width="344"
          VerticalAlignment="Top"
          Opacity="1"
          KeyDown="FlyoutRootKeyDown">
        <StackPanel Spacing="12">
            <!-- 常规视图：按用户定制的选项动态重排 -->
            <StackPanel x:Name="NormalContentPanel" Spacing="12">
                <Grid x:Name="QuickTilesGrid" ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="TileGridRow0" Height="Auto" />
                        <RowDefinition x:Name="TileGridRow1" Height="Auto" />
                        <RowDefinition x:Name="TileGridRow2" Height="Auto" />
                    </Grid.RowDefinitions>

                    <ToggleButton x:Name="TouchTile"
                                  Grid.Row="0"
                                  Grid.Column="0"
                                  Height="60"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  HorizontalContentAlignment="Left"
                                  VerticalContentAlignment="Center"
                                  Padding="12,8"
                                  CornerRadius="{ThemeResource ControlCornerRadius}"
                                  AutomationProperties.Name="接管触控与手写笔"
                                  Click="TouchTileClicked">
                        <StackPanel Spacing="5">
                            <FontIcon Glyph="&#xEDA4;" FontSize="16" HorizontalAlignment="Left" />
                            <TextBlock Text="触控接管"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Left" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton x:Name="EyeComfortTile"
                                  Grid.Row="0"
                                  Grid.Column="1"
                                  Height="60"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  HorizontalContentAlignment="Left"
                                  VerticalContentAlignment="Center"
                                  Padding="12,8"
                                  CornerRadius="{ThemeResource ControlCornerRadius}"
                                  AutomationProperties.Name="护眼模式"
                                  Click="EyeComfortTileClicked">
                        <StackPanel Spacing="5">
                            <FontIcon Glyph="&#xE7B3;" FontSize="16" HorizontalAlignment="Left" />
                            <TextBlock Text="护眼模式"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Left" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton x:Name="SmartChargeTile"
                                  Grid.Row="1"
                                  Grid.Column="0"
                                  Height="60"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  HorizontalContentAlignment="Left"
                                  VerticalContentAlignment="Center"
                                  Padding="12,8"
                                  CornerRadius="{ThemeResource ControlCornerRadius}"
                                  AutomationProperties.Name="智能充电"
                                  Click="SmartChargeTileClicked">
                        <StackPanel Spacing="5">
                            <FontIcon Glyph="&#xE945;" FontSize="16" HorizontalAlignment="Left" />
                            <TextBlock Text="智能充电"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Left" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton x:Name="KbdWirelessTile"
                                  Grid.Row="1"
                                  Grid.Column="1"
                                  Height="60"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  HorizontalContentAlignment="Left"
                                  VerticalContentAlignment="Center"
                                  Padding="12,8"
                                  CornerRadius="{ThemeResource ControlCornerRadius}"
                                  AutomationProperties.Name="键盘分离后保持无线连接"
                                  Click="KbdWirelessTileClicked">
                        <StackPanel Spacing="5">
                            <FontIcon Glyph="&#xE765;" FontSize="16" HorizontalAlignment="Left" />
                            <TextBlock Text="分离连接"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Left" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton x:Name="EnergySaverTile"
                                  Grid.Row="2"
                                  Grid.Column="0"
                                  Height="60"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  HorizontalContentAlignment="Left"
                                  VerticalContentAlignment="Center"
                                  Padding="12,8"
                                  CornerRadius="{ThemeResource ControlCornerRadius}"
                                  AutomationProperties.Name="节能模式"
                                  Visibility="Collapsed"
                                  Click="EnergySaverTileClicked">
                        <StackPanel Spacing="5">
                            <FontIcon Glyph="&#xEC0A;" FontSize="16" HorizontalAlignment="Left" />
                            <TextBlock Text="节能模式"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Left" />
                        </StackPanel>
                    </ToggleButton>
                </Grid>

                <!-- 可选色温滑条：默认隐藏，可在「编辑」里开启，避免与系统亮度混淆 -->
                <Grid x:Name="FlyoutColorTempSection"
                      ColumnSpacing="10"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="52" />
                    </Grid.ColumnDefinitions>

                    <ToggleButton x:Name="ColorTempToggle"
                                  Grid.Column="0"
                                  Width="34"
                                  Height="34"
                                  Padding="0"
                                  CornerRadius="{ThemeResource ControlCornerRadius}"
                                  AutomationProperties.Name="屏幕色温开关"
                                  ToolTipService.ToolTip="色温调节"
                                  Click="ColorTempToggleClicked">
                        <FontIcon Glyph="&#xE793;" FontSize="15" />
                    </ToggleButton>

                    <Slider x:Name="ColorTempSlider"
                            Grid.Column="1"
                            Minimum="2000"
                            Maximum="10000"
                            StepFrequency="500"
                            SmallChange="500"
                            LargeChange="1000"
                            Value="6500"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="屏幕色温"
                            ValueChanged="ColorTempSliderChanged" />

                    <TextBlock x:Name="ColorTempValueText"
                               Grid.Column="2"
                               Text="关闭"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right" />
                </Grid>

                <Border x:Name="FlyoutTopDivider"
                        Height="1"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- 本机电量、实时功耗、节能模式与电源模式切换 -->
                <StackPanel x:Name="FlyoutPowerSection" Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <local:BatteryIndicator x:Name="FlyoutHostBattery"
                                                    VerticalAlignment="Center" />
                            <TextBlock x:Name="FlyoutHostPercentText"
                                       Text="—"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="FlyoutHostStateText"
                                       Text="本机电源"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="FlyoutHostWattText"
                                   Grid.Column="1"
                                   Text=""
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                    </Grid>

                    <Grid x:Name="FlyoutPowerControlsRow" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ToggleButton x:Name="PowerEnergySaverBtn"
                                      Grid.Column="0"
                                      Height="32"
                                      MinWidth="72"
                                      Padding="10,4"
                                      CornerRadius="{ThemeResource ControlCornerRadius}"
                                      AutomationProperties.Name="节能模式"
                                      ToolTipService.ToolTip="节能模式"
                                      Click="PowerEnergySaverClicked">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="5"
                                        VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEC0A;"
                                          FontSize="13"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="节能"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>

                        <Border x:Name="FlyoutPowerModeDivider"
                                Grid.Column="1"
                                Width="1"
                                Height="16"
                                Margin="2,0"
                                VerticalAlignment="Center"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <Grid x:Name="FlyoutPowerModeGrid"
                              Grid.Column="2"
                              ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="PowerModeEfficiencyBtn"
                                          Grid.Column="0"
                                          Height="32"
                                          Padding="6,4"
                                          HorizontalAlignment="Stretch"
                                          CornerRadius="{ThemeResource ControlCornerRadius}"
                                          Content="能效"
                                          FontSize="12"
                                          AutomationProperties.Name="最佳能效"
                                          ToolTipService.ToolTip="最佳能效"
                                          Click="PowerModeEfficiencyClicked" />
                            <ToggleButton x:Name="PowerModeBalancedBtn"
                                          Grid.Column="1"
                                          Height="32"
                                          Padding="6,4"
                                          HorizontalAlignment="Stretch"
                                          CornerRadius="{ThemeResource ControlCornerRadius}"
                                          Content="平衡"
                                          FontSize="12"
                                          AutomationProperties.Name="平衡模式"
                                          ToolTipService.ToolTip="平衡"
                                          Click="PowerModeBalancedClicked" />
                            <ToggleButton x:Name="PowerModePerformanceBtn"
                                          Grid.Column="2"
                                          Height="32"
                                          Padding="6,4"
                                          HorizontalAlignment="Stretch"
                                          CornerRadius="{ThemeResource ControlCornerRadius}"
                                          Content="性能"
                                          FontSize="12"
                                          AutomationProperties.Name="最佳性能"
                                          ToolTipService.ToolTip="最佳性能"
                                          Click="PowerModePerformanceClicked" />
                        </Grid>
                    </Grid>
                </StackPanel>

                <Border x:Name="FlyoutAccessoryDivider"
                        Height="1"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Visibility="Collapsed" />

                <!-- 配件电量状态行 -->
                <StackPanel x:Name="FlyoutAccessorySection"
                            Spacing="6"
                            Visibility="Collapsed">
                    <Grid x:Name="FlyoutPenRow"
                          ColumnSpacing="12"
                          MinHeight="26"
                          Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FlyoutPenName"
                                   Text="HUAWEI M-Pencil"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <local:BatteryIndicator x:Name="FlyoutPenBattery"
                                                Grid.Column="1"
                                                VerticalAlignment="Center" />
                        <TextBlock x:Name="FlyoutPenStatus"
                                   Grid.Column="1"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                    </Grid>

                    <Grid x:Name="FlyoutKeyboardRow"
                          ColumnSpacing="12"
                          MinHeight="26"
                          Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FlyoutKeyboardName"
                                   Text="HUAWEI 智能磁吸键盘"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <local:BatteryIndicator x:Name="FlyoutKeyboardBattery"
                                                Grid.Column="1"
                                                VerticalAlignment="Center" />
                        <TextBlock x:Name="FlyoutKeyboardStatus"
                                   Grid.Column="1"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                    </Grid>
                </StackPanel>

                <TextBlock x:Name="FlyoutEmptyHintText"
                           Text="当前未显示快捷项，点击下方“编辑”选择要展示的内容。"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>

            <!-- 内联自定义编辑视图 -->
            <StackPanel x:Name="EditContentPanel"
                        Spacing="6"
                        Visibility="Collapsed">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="自定义快捷面板"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="恢复默认"
                            Padding="8,4"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Click="ResetFlyoutItemsClicked" />
                </Grid>

                <StackPanel Spacing="2">
                    <CheckBox x:Name="EditCheckTouch"
                              Content="触控接管"
                              MinHeight="30"
                              Click="EditItemCheckClicked" />
                    <CheckBox x:Name="EditCheckEyeComfort"
                              Content="护眼模式"
                              MinHeight="30"
                              Click="EditItemCheckClicked" />
                    <CheckBox x:Name="EditCheckSmartCharge"
                              Content="智能充电"
                              MinHeight="30"
                              Click="EditItemCheckClicked" />
                    <CheckBox x:Name="EditCheckKbdWireless"
                              Content="分离连接"
                              MinHeight="30"
                              Click="EditItemCheckClicked" />
                    <CheckBox x:Name="EditCheckEnergySaver"
                              Content="节能模式磁贴"
                              MinHeight="30"
                              Click="EditItemCheckClicked" />
                    <CheckBox x:Name="EditCheckColorTemp"
                              Content="色温调节滑条"
                              MinHeight="30"
                              Click="EditItemCheckClicked" />
                    <CheckBox x:Name="EditCheckHostPower"
                              Content="本机电量、节能与性能模式"
                              MinHeight="30"
                              Click="EditItemCheckClicked" />
                    <CheckBox x:Name="EditCheckAccessories"
                              Content="手写笔与键盘电量"
                              MinHeight="30"
                              Click="EditItemCheckClicked" />
                </StackPanel>
            </StackPanel>

            <Border Height="1"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- 底栏：左侧编辑/完成，右侧所有设置 -->
            <Grid ColumnSpacing="8" MinHeight="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="EditFlyoutButton"
                        Grid.Column="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Padding="8,6"
                        MinHeight="32"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="编辑快捷面板"
                        Click="EditFlyoutClicked">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="EditFlyoutIcon" Glyph="&#xE70F;" FontSize="13" />
                        <TextBlock x:Name="EditFlyoutText"
                                   Text="编辑"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="OpenSettingsButton"
                        Grid.Column="1"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Padding="10,6"
                        MinHeight="32"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="所有设置"
                        Click="OpenSettingsClicked">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                        <TextBlock Text="所有设置"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
