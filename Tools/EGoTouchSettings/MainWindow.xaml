<Window
    x:Class="EGoTouchSettings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EGoTouchSettings"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootLayout" Background="Transparent">
        <!-- Window 没有 Resources 属性，页面级样式只能挂在根 Grid 上。 -->
        <Grid.Resources>
            <Style x:Key="SettingsCardStyle" TargetType="Border">
                <Setter Property="MinHeight" Value="72" />
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <!-- 只有一两行文字、没有右侧控件的卡片。SettingsCardStyle 的 MinHeight 是给
                 「图标 + 标题 + 描述 + 控件」那种行准备的，用在纯文本上会在下方空出半张
                 卡片，字还小，看起来像没加载完。 -->
            <Style x:Key="SettingsCardCompactStyle" TargetType="Border"
                   BasedOn="{StaticResource SettingsCardStyle}">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="16,12" />
            </Style>

            <Style x:Key="SettingsGroupHeaderStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="4,0,0,4" />
            </Style>

            <!-- 带图标的分组标题，用在成段的规格列表上（设备页与电池页）。图标本身不表达
                 新信息，作用是让几段并列的规格在扫读时有落点——纯文字标题连着几张卡片，
                 视线找不到分界。
                 这两个样式配合 GroupHeaderRowStyle 使用，三者要一起改。 -->
            <Style x:Key="SpecGroupIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="SpecGroupTitleStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="GroupHeaderRowStyle" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal" />
                <Setter Property="Spacing" Value="8" />
                <Setter Property="Margin" Value="4,0,0,4" />
            </Style>

            <Style x:Key="SettingsDescriptionStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SettingsRowIconStyle" TargetType="FontIcon">
                <Setter Property="Width" Value="24" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 设备页的一行属性：左标签右取值，取值缺失时整行由代码隐藏。 -->
            <Style x:Key="DeviceFieldLabelStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="DeviceFieldValueStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            Title="OpenEGo Hub">
            <!-- 图标在代码里设，见 SetTitleBarIconAsync：图片嵌在 exe 的 RCDATA 里，
                 XAML 这边没法直接引。
                 不要改用 PathIconSource——那会让窗口一显示就抛 0xC000027B，是
                 microsoft-ui-xaml#9784，内联几何和资源查找都一样。 -->
        </TitleBar>

        <!-- 六页共用一个 NavigationView，内容用 Visibility 切换而不是 Frame 导航：
             Frame 要求每页各自是一个 WinRT 类型，得为每一页加 .idl 条目和生成代码，而页面之间
             要共享的状态（托盘连接、服务是否就绪）又都挂在这个窗口上，拆成独立类型之后还得
             再把它们传回去。页数变多也没有改变这笔账。 -->
        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Auto"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            OpenPaneLength="180"
            SelectionChanged="NavSelectionChanged"
            ItemInvoked="NavItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavDevices" Content="配件" Tag="devices" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE772;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavBattery" Content="电池" Tag="battery">
                    <NavigationViewItem.Icon>
                        <!-- 与电量指示器取自同一组线框电池，见 BatteryIndicator。 -->
                        <FontIcon Glyph="&#xE859;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavScreen" Content="屏幕" Tag="screen">
                    <NavigationViewItem.Icon>
                        <!-- 这一页调的是色温、护眼和色域，用亮度而不是显示器：本机是一块
                             平板，画一台带底座的显示器指的是别的东西。 -->
                        <FontIcon Glyph="&#xE706;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavGeneral" Content="服务" Tag="general">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9F5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavDevice" Content="设备" Tag="device">
                    <NavigationViewItem.Icon>
                        <!-- 这一页列的是处理器、内存这些本机规格，不是「另一台设备」。 -->
                        <FontIcon Glyph="&#xE950;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <!-- 外观只有三个互斥选项，撑不起一页，也不该塞进哪一页的末尾——它管的是整个
                     窗口，不属于配件或屏幕。放在导航栏底部、关于之上，用 flyout 就地选，
                     SelectsOnInvoked="False" 让它不参与选页。 -->
                <NavigationViewItem x:Name="NavTheme" Content="外观" Tag="theme"
                                    SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                    <FlyoutBase.AttachedFlyout>
                        <MenuFlyout Placement="Right">
                            <RadioMenuFlyoutItem x:Name="ThemeSystemItem" Text="跟随系统"
                                                 GroupName="AppTheme" Tag="system"
                                                 Click="ThemeSelected" />
                            <RadioMenuFlyoutItem x:Name="ThemeLightItem" Text="浅色"
                                                 GroupName="AppTheme" Tag="light"
                                                 Click="ThemeSelected" />
                            <RadioMenuFlyoutItem x:Name="ThemeDarkItem" Text="深色"
                                                 GroupName="AppTheme" Tag="dark"
                                                 Click="ThemeSelected" />
                        </MenuFlyout>
                    </FlyoutBase.AttachedFlyout>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavAbout" Content="关于" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- 内容铺满可用宽度，与 Windows 设置一致。不要加 MaxWidth：加了之后要么右侧空出
                 一大片，要么得配 HorizontalAlignment 才能定位，而 Stretch 配 MaxWidth 的落位
                 本身没有定论（实测最大化后内容整体贴到右侧）。铺满是唯一不需要额外约定的写法。 -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- InfoBar 播报的是整个程序范围的状态（托盘未运行、切换失败、正在退出），
                     并且会决定设置页控件是否可用。放在滚动区之外、导航内容区之上，
                     换页和滚动都不会让它消失。 -->
                <StackPanel Grid.Row="0" Spacing="4">
                    <InfoBar
                        x:Name="StatusInfoBar"
                        Margin="24,0,24,0"
                        IsOpen="False"
                        IsClosable="False"
                        Severity="Informational" />
                    <!-- 华为服务还开着时的提醒。跨页面常驻，因为这件事与用户当前在看哪一页
                         无关；关掉一次就永久不再出现——他已经表达了「我不想禁用」，反复问
                         是骚扰。 -->
                    <InfoBar
                        x:Name="VendorHintBar"
                        Margin="24,0,24,4"
                        IsOpen="False"
                        IsClosable="True"
                        Severity="Informational"
                        Title="华为后台服务仍在运行"
                        Message="触控、手写笔、键盘与充电控制已由本程序接管，这些服务可以停用。"
                        CloseButtonClick="VendorHintDismissed">
                        <InfoBar.ActionButton>
                            <Button Content="去处理" Click="VendorHintActionClicked" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </StackPanel>

                <!-- ── 设备页 ── -->
                <ScrollViewer
                    x:Name="DevicesPage"
                    Grid.Row="1"
                    SizeChanged="DeviceCardsSizeChanged"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="DeviceCards" Padding="24,8,24,24"
                          ColumnSpacing="24" RowSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <!-- 第二列的宽度由 DeviceCardsSizeChanged 在 0 与 * 之间切换：
                                 窄窗口时为 0，两张卡片纵向堆叠；够宽时变成 *，键盘卡片移到右侧。 -->
                            <ColumnDefinition x:Name="DeviceSecondColumn" Width="0" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <!-- 设置项跨满两列，摆在两张卡片下面。窄窗口时第二列宽度为 0，
                                 跨列不影响它，仍然是整宽一行。 -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 笔 -->
                        <StackPanel x:Name="PenGroup" Grid.Row="0" Grid.Column="0" Spacing="4"
                                    VerticalAlignment="Top">
                            <TextBlock Text="笔" Style="{StaticResource SettingsGroupHeaderStyle}" />
                            <Border Style="{StaticResource SettingsCardCompactStyle}">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- 产品图取自已安装的 PCManager，取不到时代码会把它隐藏，
                                             并让左侧退回到一个图标，不留一块空白。 -->
                                        <Image x:Name="PenImage" Width="120" Height="64"
                                               Stretch="Uniform" VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                        <FontIcon x:Name="PenImageFallback" Glyph="&#xE70F;" FontSize="28"
                                                  Width="120" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock x:Name="PenNameText" Text="M-Pencil"
                                                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:Name="PenStateText" Text="未连接"
                                                       Style="{StaticResource SettingsDescriptionStyle}" />
                                        </StackPanel>
                                        <local:BatteryIndicator x:Name="PenBatteryIndicator"
                                                                Grid.Column="2"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center" />
                                    </Grid>

                                    <StackPanel x:Name="PenIdentityGroup" Spacing="6" Visibility="Collapsed">
                                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                        <Grid x:Name="PenFirmwareRow" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="固件版本" Style="{StaticResource DeviceFieldLabelStyle}" />
                                            <TextBlock x:Name="PenFirmwareText" Grid.Column="1"
                                                       Style="{StaticResource DeviceFieldValueStyle}" />
                                        </Grid>
                                        <Grid x:Name="PenHardwareRow" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="硬件版本" Style="{StaticResource DeviceFieldLabelStyle}" />
                                            <TextBlock x:Name="PenHardwareText" Grid.Column="1"
                                                       Style="{StaticResource DeviceFieldValueStyle}" />
                                        </Grid>
                                        <Grid x:Name="PenSerialRow" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="序列号" Style="{StaticResource DeviceFieldLabelStyle}" />
                                            <TextBlock x:Name="PenSerialText" Grid.Column="1"
                                                       Style="{StaticResource DeviceFieldValueStyle}"
                                                       IsTextSelectionEnabled="True" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 键盘 -->
                        <StackPanel x:Name="KeyboardGroup" Grid.Row="1" Grid.Column="0" Spacing="4"
                                    VerticalAlignment="Top">
                            <TextBlock Text="键盘" Style="{StaticResource SettingsGroupHeaderStyle}" />
                            <Border Style="{StaticResource SettingsCardCompactStyle}">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image x:Name="KeyboardImage" Width="120" Height="64"
                                               Stretch="Uniform" VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                        <FontIcon x:Name="KeyboardImageFallback" Glyph="&#xE765;" FontSize="28"
                                                  Width="120" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock x:Name="KeyboardNameText" Text="键盘"
                                                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:Name="KeyboardStateText" Text="未检测到键盘"
                                                       Style="{StaticResource SettingsDescriptionStyle}" />
                                        </StackPanel>
                                        <local:BatteryIndicator x:Name="KeyboardBatteryIndicator"
                                                                Grid.Column="2"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Right" />
                                    </Grid>

                                    <StackPanel x:Name="KeyboardIdentityGroup" Spacing="6" Visibility="Collapsed">
                                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="固件版本" Style="{StaticResource DeviceFieldLabelStyle}" />
                                            <TextBlock x:Name="KeyboardFirmwareText" Grid.Column="1"
                                                       Style="{StaticResource DeviceFieldValueStyle}" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 笔与键盘的设置项。放在两张状态卡片下面而不是单独一页：它们要改的
                             正是上面这两个设备，隔一页去调整会让人先怀疑自己找错了地方。 -->
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="24">
                            <StackPanel Spacing="4">
                                <TextBlock Text="笔" Style="{StaticResource SettingsGroupHeaderStyle}" />
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE70F;" Style="{StaticResource SettingsRowIconStyle}" />
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="双击行为" TextWrapping="Wrap" />
                                            <TextBlock
                                                Text="选择连按两次笔侧键时执行的操作。"
                                                Style="{StaticResource SettingsDescriptionStyle}" />
                                        </StackPanel>
                                        <ComboBox
                                            x:Name="PenModeSelector"
                                            Grid.Column="2"
                                            MinWidth="180"
                                            VerticalAlignment="Center"
                                            SelectionChanged="PenModeSelectionChanged">
                                            <ComboBoxItem Content="遵循系统笔设置" />
                                            <ComboBoxItem Content="切换书写与橡皮擦" />
                                        </ComboBox>
                                    </Grid>
                                </Border>
                                <Border x:Name="OneNoteCompatibilityRow" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE70B;" Style="{StaticResource SettingsRowIconStyle}" />
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="OneNote 兼容" TextWrapping="Wrap" />
                                            <TextBlock
                                                x:Name="OneNoteCompatibilityStatusText"
                                                Text="切换工具时同步 OneNote 的绘图选项。"
                                                Style="{StaticResource SettingsDescriptionStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            x:Name="OneNoteCompatibilityToggle"
                                            Grid.Column="2"
                                            MinWidth="0"
                                            OnContent=""
                                            OffContent=""
                                            Margin="0,0,-12,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Toggled="OneNoteCompatibilityToggled" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="键盘" Style="{StaticResource SettingsGroupHeaderStyle}" />
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE765;" Style="{StaticResource SettingsRowIconStyle}" />
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="分离后保持无线连接" TextWrapping="Wrap" />
                                            <TextBlock
                                                x:Name="KeyboardStatusText"
                                                Text="键盘与主机分离后继续通过无线方式使用。"
                                                Style="{StaticResource SettingsDescriptionStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            x:Name="KeyboardWirelessToggle"
                                            Grid.Column="2"
                                            MinWidth="0"
                                            OnContent=""
                                            OffContent=""
                                            Margin="0,0,-12,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Toggled="KeyboardWirelessToggled" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- ── 电池页 ── -->
                <ScrollViewer
                    x:Name="BatteryPage"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Padding="24,8,24,24" Spacing="24">

                        <!-- 当前状态。电量与剩余时间同属高频项，一起刷新。
                             充放电方向看功率的符号，不看「是否接着电源」：充电上限生效时机器
                             正处在插着电却在放电的状态，用接电源反推会一直显示成充电中。 -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="12"
                                                VerticalAlignment="Center">
                                        <TextBlock
                                            x:Name="BatteryPercentText"
                                            Text="—"
                                            Style="{ThemeResource TitleLargeTextBlockStyle}" />
                                        <TextBlock
                                            x:Name="BatteryStateText"
                                            Text="正在读取"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,0,6"
                                            Style="{StaticResource SettingsDescriptionStyle}" />
                                    </StackPanel>
                                    <ProgressBar
                                        x:Name="BatteryLevelBar"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="0" />
                                    <TextBlock
                                        x:Name="BatteryTimeText"
                                        Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <FontIcon
                                    Grid.Column="1"
                                    Glyph="&#xE83F;"
                                    FontSize="32"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Border>

                        <StackPanel Spacing="4">
                            <TextBlock Text="充电" Style="{StaticResource SettingsGroupHeaderStyle}" />
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- EC48 是 LightningBolt，与下面那条固定上限区分开。 -->
                                    <FontIcon Glyph="&#xEC48;" Style="{StaticResource SettingsRowIconStyle}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="智能充电" TextWrapping="Wrap" />
                                        <TextBlock
                                            Text="由系统按使用习惯自动调整充电上限。"
                                            Style="{StaticResource SettingsDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        x:Name="SmartChargeToggle"
                                        Grid.Column="2"
                                        MinWidth="0"
                                        OnContent=""
                                        OffContent=""
                                        Margin="0,0,-12,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Toggled="SmartChargeToggled" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- E83E 是 BatteryCharging。 -->
                                    <FontIcon Glyph="&#xE83E;" Style="{StaticResource SettingsRowIconStyle}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="充电上限" TextWrapping="Wrap" />
                                        <TextBlock
                                            x:Name="ChargeLimitStatusText"
                                            Text="长期插电时限制充电上限可以减缓电池老化。电量低于上限 5 个百分点时恢复充电。"
                                            Style="{StaticResource SettingsDescriptionStyle}" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                        <Slider
                                            x:Name="ChargeLimitSlider"
                                            Width="160"
                                            Minimum="50"
                                            Maximum="100"
                                            StepFrequency="5"
                                            TickFrequency="10"
                                            TickPlacement="Outside"
                                            VerticalAlignment="Center"
                                            ValueChanged="ChargeLimitChanged" />
                                        <TextBlock
                                            x:Name="ChargeLimitValueText"
                                            Text="100%"
                                            MinWidth="44"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- 健康与标识都是低频项，打开面板读一次即可，不随电量刷新。 -->
                        <StackPanel Spacing="4">
                            <StackPanel Style="{StaticResource GroupHeaderRowStyle}">
                                <FontIcon Glyph="&#xE83E;" Style="{StaticResource SpecGroupIconStyle}" />
                                <TextBlock Text="健康" Style="{StaticResource SpecGroupTitleStyle}" />
                            </StackPanel>
                            <Border Style="{StaticResource SettingsCardCompactStyle}">
                                <!-- 四项排成两列。这几个值都很短（81.8%、233 次、36.9 Wh、
                                     8.51 V），一项一行会让整页高出一屏、多出一段无谓的滚动，
                                     而两列并排扫读反而更快。 -->
                                <Grid ColumnSpacing="16" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" MinWidth="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="健康度"
                                               Style="{StaticResource SettingsDescriptionStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="BatteryHealthText"
                                               TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="电压"
                                               Style="{StaticResource SettingsDescriptionStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="3" x:Name="BatteryVoltageText"
                                               TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="循环次数"
                                               Style="{StaticResource SettingsDescriptionStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="BatteryCyclesText"
                                               TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="容量"
                                               Style="{StaticResource SettingsDescriptionStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" x:Name="BatteryCapacityText"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <StackPanel Style="{StaticResource GroupHeaderRowStyle}">
                                <FontIcon Glyph="&#xE946;" Style="{StaticResource SpecGroupIconStyle}" />
                                <TextBlock Text="标识" Style="{StaticResource SpecGroupTitleStyle}" />
                            </StackPanel>
                            <Border Style="{StaticResource SettingsCardCompactStyle}">
                                <!-- 型号占整行，制造商与序列号并排：后两者都很短
                                     （SUNWODA、28978），各占一行只是在拉高页面。 -->
                                <Grid ColumnSpacing="16" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" MinWidth="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="型号"
                                               Style="{StaticResource SettingsDescriptionStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                                               x:Name="BatteryModelText" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="制造商"
                                               Style="{StaticResource SettingsDescriptionStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="BatteryVendorText"
                                               TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="序列号"
                                               Style="{StaticResource SettingsDescriptionStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" x:Name="BatterySerialText"
                                               IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ── 屏幕页 ── -->
                <ScrollViewer
                    x:Name="ScreenPage"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Padding="24,8,24,24" Spacing="24">

                        <!-- 色彩对照。照片看整体观感，灰阶看有没有偏色——中性色上最藏不住，
                             一条灰阶比一堆彩色块更能说明问题。
                             照片本身不是校色依据：它只能给出「切过去变了、往哪个方向变」，
                             要判断哪一档更准得靠色度计。 -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="对照" Style="{StaticResource SettingsGroupHeaderStyle}" />
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="8">
                                    <Border CornerRadius="4">
                                        <Border.Clip>
                                            <!-- Image 自己不裁剪圆角，得靠外层的 Clip。矩形尺寸
                                                 在 SizeChanged 里跟着实际宽度更新。 -->
                                            <RectangleGeometry x:Name="ColorReferenceClip" />
                                        </Border.Clip>
                                        <Image
                                            x:Name="ColorReferenceImage"
                                            Height="180"
                                            Stretch="UniformToFill"
                                            SizeChanged="ColorReferenceSizeChanged" />
                                    </Border>
                                    <Grid Height="24" ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- 纯白与纯黑留在两端：色温和护眼在这两块上最容易辨认。 -->
                                        <Border Grid.Column="0" CornerRadius="4" Background="#FFFFFF" />
                                        <Border Grid.Column="1" CornerRadius="4" Background="#C8C8C8" />
                                        <Border Grid.Column="2" CornerRadius="4" Background="#969696" />
                                        <Border Grid.Column="3" CornerRadius="4" Background="#646464" />
                                        <Border Grid.Column="4" CornerRadius="4" Background="#323232" />
                                        <Border Grid.Column="5" CornerRadius="4" Background="#000000" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="色彩" Style="{StaticResource SettingsGroupHeaderStyle}" />
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- E790 是 Color，描边调色盘，与本页其余图标同为描边字形。 -->
                                    <FontIcon Glyph="&#xE790;" Style="{StaticResource SettingsRowIconStyle}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="色域" TextWrapping="Wrap" />
                                        <TextBlock
                                            x:Name="ColorModeStatusText"
                                            Text="套用屏幕的出厂色彩校准，仅对内置屏幕生效。"
                                            Style="{StaticResource SettingsDescriptionStyle}" />
                                    </StackPanel>
                                    <ComboBox
                                        x:Name="ColorModeCombo"
                                        Grid.Column="2"
                                        MinWidth="140"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        SelectionChanged="ColorModeChanged">
                                        <!-- 三项与本机 config\icc\Gaokun3 下的三个 ICC 一一对应。
                                             Native 不套任何 LUT，是面板的原生色域，不是「复位」。 -->
                                        <ComboBoxItem Content="Native" />
                                        <ComboBoxItem Content="sRGB" />
                                        <ComboBoxItem Content="Display P3" />
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- 色温与下面两项走同一个硬件通道（PCC），三者的增益合成后一次
                                 下发。色域走的是 3D LUT，与它们互不干扰。 -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <!-- 开关与滑条分成上下两行。滑条上没有「关闭」这个位置——最左端
                                     是 2000K，是一个很暖的值而不是关掉，所以关闭得另给一个开关。 -->
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- E793 是 Brightness，用来指代冷暖。 -->
                                        <FontIcon Glyph="&#xE793;" Style="{StaticResource SettingsRowIconStyle}" />
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="色温" TextWrapping="Wrap" />
                                            <TextBlock
                                                x:Name="ColorTemperatureStatusText"
                                                Text="调节屏幕的冷暖。数值越低画面越暖。"
                                                Style="{StaticResource SettingsDescriptionStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            x:Name="ColorTemperatureToggle"
                                            Grid.Column="2"
                                            MinWidth="0"
                                            OnContent=""
                                            OffContent=""
                                            Margin="0,0,-12,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Toggled="ColorTemperatureToggled" />
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" MinWidth="56" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- 两端标注冷暖而不是标数字：开尔文值与观感的对应关系
                                             不是常识，数值本身已经在右侧显示了。 -->
                                        <TextBlock Text="暖" VerticalAlignment="Center"
                                                   Style="{StaticResource SettingsDescriptionStyle}" />
                                        <!-- 步长 500K：厂商用的是一张九点标定表，点与点之间本来
                                             就是插值，再细的刻度并不对应更多真实数据。 -->
                                        <Slider
                                            x:Name="ColorTemperatureSlider"
                                            Grid.Column="1"
                                            Minimum="2000"
                                            Maximum="10000"
                                            StepFrequency="500"
                                            TickFrequency="2000"
                                            TickPlacement="Outside"
                                            VerticalAlignment="Center"
                                            ValueChanged="ColorTemperatureChanged" />
                                        <TextBlock
                                            x:Name="ColorTemperatureValueText"
                                            Grid.Column="2"
                                            Text="关闭"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right" />
                                        <!-- 重置回中性点，不是关闭——关闭有上面那个开关。 -->
                                        <Button
                                            x:Name="ColorTemperatureResetButton"
                                            Grid.Column="3"
                                            Padding="6"
                                            MinWidth="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="重置为 6500K"
                                            Click="ColorTemperatureResetClicked">
                                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- E7B3 是 RedEye。 -->
                                    <FontIcon Glyph="&#xE7B3;" Style="{StaticResource SettingsRowIconStyle}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="护眼模式" TextWrapping="Wrap" />
                                        <TextBlock
                                            Text="减弱蓝光。此模式下屏幕偏黄为正常现象。"
                                            Style="{StaticResource SettingsDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        x:Name="EyeComfortToggle"
                                        Grid.Column="2"
                                        MinWidth="0"
                                        OnContent=""
                                        OffContent=""
                                        Margin="0,0,-12,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Toggled="EyeComfortToggled" />
                                </Grid>
                            </Border>

                            <!-- 自然色彩这一项不在界面上出现：本机的环境光传感器读不出持续
                                 数据，开关打开也不会有任何变化。tcs3701 在驱动初始化时上报一帧，
                                 之后不再采样，WinRT 与 COM 两条栈拿到的都是同一份陈旧缓存，问题
                                 在高通传感器驱动一侧，够不着。实现留在 hal/src/display/
                                 NaturalColor.* 与 LightSensor.*，换机器或驱动修好之后接回来即可，
                                 诊断入口是 GaokunDisplay 的 sensor-probe 命令。 -->
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ── 通用页 ── -->
                <ScrollViewer
                    x:Name="GeneralPage"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Padding="24,8,24,24" Spacing="24">

                        <!-- 每个 ToggleSwitch 上的 MinWidth / OnContent / OffContent / Margin 是一组，
                             用来让开关本体贴住卡片右缘，与 ComboBox 和按钮的右缘对齐：
                             默认 MinWidth 154 里只有左边约 40 是开关本体，其余是给 On/Off 文字预留的，
                             清掉文字那段宽度也不会收回；模板中开关与文字之间还有一个写死 12 的列，文字
                             为空后它就是纯粹的尾部留白，只能用负边距抵掉。
                             这几个值必须写在控件上。同样的设置放进 Style 的 Setter 里，MinWidth 不会生效，
                             实测开关仍按 154 排布。 -->

                        <!-- 系统 -->
                        <!-- 华为服务。放在最前：这一页的其余各项都是本程序自己的开关，只有
                             这一条动的是系统上别人的东西，代价也最大。 -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="华为服务" Style="{StaticResource SettingsGroupHeaderStyle}" />
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE7C9;" Style="{StaticResource SettingsRowIconStyle}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="禁用华为后台服务" TextWrapping="Wrap" />
                                        <TextBlock
                                            x:Name="VendorServicesStatusText"
                                            Text="正在检查…"
                                            Style="{StaticResource SettingsDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        x:Name="VendorServicesToggle"
                                        Grid.Column="2"
                                        MinWidth="0"
                                        OnContent=""
                                        OffContent=""
                                        Margin="0,0,-12,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Toggled="VendorServicesToggled" />
                                </Grid>
                            </Border>
                            <!-- 只在启动类型已禁用、进程却还活着时出现。正常路径下停用会
                                 连进程一起收掉，这一条不会显示——所以它不是「改完要重启」
                                 那种常规提示，出现了就说明有东西没收干净。 -->
                            <InfoBar
                                x:Name="VendorServicesRestartBar"
                                IsOpen="False"
                                IsClosable="False"
                                Severity="Warning"
                                Title="有服务仍在运行"
                                Message="已设为禁用，但有进程没有退出。重启后不会再启动。" />
                        </StackPanel>

                        <!-- 本程序 -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="本程序" Style="{StaticResource SettingsGroupHeaderStyle}" />
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- EA8F 是 Ringer，一个描边铃铛。这一列其余几个都是描边字形，
                                         而 E7E7（ActionCenterNotification）是实心横幅，混在里面很扎眼。 -->
                                    <FontIcon Glyph="&#xEA8F;" Style="{StaticResource SettingsRowIconStyle}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="设备提示弹窗" TextWrapping="Wrap" />
                                        <TextBlock
                                            Text="手写笔或键盘接入时显示提示。"
                                            Style="{StaticResource SettingsDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        x:Name="DeviceNotificationsToggle"
                                        Grid.Column="2"
                                        MinWidth="0"
                                        OnContent=""
                                        OffContent=""
                                        Margin="0,0,-12,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Toggled="DeviceNotificationsToggled" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE768;" Style="{StaticResource SettingsRowIconStyle}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="登录后自动启用" TextWrapping="Wrap" />
                                        <TextBlock
                                            Text="登录 Windows 后启动托盘并接管触控。"
                                            Style="{StaticResource SettingsDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        x:Name="AutoStartToggle"
                                        Grid.Column="2"
                                        MinWidth="0"
                                        OnContent=""
                                        OffContent=""
                                        Margin="0,0,-12,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Toggled="AutoStartToggled" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- E7E8 是 PowerButton。原先用的 E7E7 是 ActionCenterNotification，
                                         一个通知中心图标，与退出毫无关系。 -->
                                    <FontIcon Glyph="&#xE7E8;" Style="{StaticResource SettingsRowIconStyle}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="退出并交还原厂" TextWrapping="Wrap" />
                                        <TextBlock
                                            Text="触控与手写笔交还华为驱动，并关闭托盘。"
                                            Style="{StaticResource SettingsDescriptionStyle}" />
                                    </StackPanel>
                                    <Button
                                        x:Name="ExitButton"
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Content="退出"
                                        Click="ExitClicked" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ── 设备页 ── -->
                <ScrollViewer
                    x:Name="DevicePage"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Padding="24,8,24,24" Spacing="24">

                        <!-- 整机图取自本机键盘插件里的 snapping.png，见 AccessoryImages::ResolveMachine。
                             机型名用 SMBIOS 的 Family 字段，固件里写的就是「MateBook E」，
                             不需要自己维护型号码到营销名的映射。 -->
                        <!-- 这一段也装进卡片，与页面上其余各段一致。整机图是深灰的，摊在页面
                             底色上时深色主题里几乎看不出边界，卡片的底色和描边正好把它托住。 -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="MachineNameText"
                                        Text="本机"
                                        Style="{ThemeResource TitleTextBlockStyle}" />
                                    <TextBlock
                                        x:Name="MachineIdentityText"
                                        Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <Image
                                    x:Name="MachineImage"
                                    Grid.Column="1"
                                    Width="120"
                                    Height="120"
                                    Stretch="Uniform"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 硬件 -->
                        <StackPanel Spacing="4">
                            <StackPanel Style="{StaticResource GroupHeaderRowStyle}">
                                <FontIcon Glyph="&#xE977;" Style="{StaticResource SpecGroupIconStyle}" />
                                <TextBlock Text="硬件" Style="{StaticResource SpecGroupTitleStyle}" />
                            </StackPanel>
                            <Border Style="{StaticResource SettingsCardCompactStyle}">
                                <!-- 整卡一个网格，长值跨列。分成几个各自独立的 Grid 会让列宽
                                     各算各的，值的起始位置对不齐——三行看起来像三段。 -->
                                <Grid ColumnSpacing="16" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" MinWidth="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="处理器"
                                               Style="{StaticResource SettingsDescriptionStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DeviceProcessorText"
                                               TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="核心"
                                               Style="{StaticResource SettingsDescriptionStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="3" x:Name="DeviceCoresText"
                                               TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="内存"
                                               Style="{StaticResource SettingsDescriptionStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DeviceMemoryText"
                                               TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="屏幕"
                                               Style="{StaticResource SettingsDescriptionStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" x:Name="DeviceDisplayText"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- 系统 -->
                        <StackPanel Spacing="4">
                            <StackPanel Style="{StaticResource GroupHeaderRowStyle}">
                                <!-- Windows 11 的标记：四个等大的圆角方块。自己画而不是找字形，
                                     Segoe Fluent 里没有可靠的 Windows 标记，用别的图标顶替
                                     反而看不出这一栏讲的是操作系统。
                                     颜色跟着其余分组图标走次要色，不用品牌蓝——这里要的是
                                     指代而不是强调。 -->
                                <!-- 13 而不是跟 FontIcon 一样的 15：字形本身带留白，实心方块
                                     占满整个尺寸，同样数值下看起来会大一圈。 -->
                                <Viewbox Width="13" Height="13" VerticalAlignment="Center">
                                    <Grid Width="16" Height="16" ColumnSpacing="1.8" RowSpacing="1.8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Rectangle Grid.Row="0" Grid.Column="0" RadiusX="0.8" RadiusY="0.8"
                                                   Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Rectangle Grid.Row="0" Grid.Column="1" RadiusX="0.8" RadiusY="0.8"
                                                   Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Rectangle Grid.Row="1" Grid.Column="0" RadiusX="0.8" RadiusY="0.8"
                                                   Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Rectangle Grid.Row="1" Grid.Column="1" RadiusX="0.8" RadiusY="0.8"
                                                   Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </Viewbox>
                                <TextBlock Text="系统" Style="{StaticResource SpecGroupTitleStyle}" />
                            </StackPanel>
                            <Border Style="{StaticResource SettingsCardCompactStyle}">
                                <Grid ColumnSpacing="16" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Windows"
                                               Style="{StaticResource SettingsDescriptionStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DeviceOsText"
                                               TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="BIOS"
                                               Style="{StaticResource SettingsDescriptionStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DeviceBiosText"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- 标识 -->
                        <StackPanel Spacing="4">
                            <StackPanel Style="{StaticResource GroupHeaderRowStyle}">
                                <FontIcon Glyph="&#xE946;" Style="{StaticResource SpecGroupIconStyle}" />
                                <TextBlock Text="标识" Style="{StaticResource SpecGroupTitleStyle}" />
                            </StackPanel>
                            <Border Style="{StaticResource SettingsCardCompactStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" MinWidth="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="序列号" Style="{StaticResource SettingsDescriptionStyle}" />
                                    <TextBlock
                                        x:Name="DeviceSerialText"
                                        Grid.Column="1"
                                        IsTextSelectionEnabled="True"
                                        TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="2" Text="配置"
                                               Style="{StaticResource SettingsDescriptionStyle}" />
                                    <TextBlock Grid.Column="3" x:Name="DeviceSkuText" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ── 关于页 ── -->
                <ScrollViewer
                    x:Name="AboutPage"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Padding="24,8,24,24" Spacing="24">

                        <!-- 关于页是标记唯一以完整三层出现的地方。这里不缩到图标尺寸，
                             层与层之间的明暗差正是它要表达的东西：一个接触点在电容图上
                             由强到弱的等高线。 -->
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Viewbox Width="52" Height="52" VerticalAlignment="Center">
                                <Grid Width="24" Height="24">
                                    <!-- BRAND-MARK:BEGIN -->
                                    <!-- 由 scripts/make_brand_assets.py 从 Assets/brand/openego-hub.svg 生成，不要手改。 -->
                                    <Path Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.5">
                                        <Path.Data>
                                            <GeometryGroup FillRule="EvenOdd">
                                            <EllipseGeometry Center="12,12" RadiusX="11" RadiusY="9.2">
                                                <EllipseGeometry.Transform>
                                                    <RotateTransform Angle="-22" CenterX="12" CenterY="12" />
                                                </EllipseGeometry.Transform>
                                            </EllipseGeometry>
                                            <EllipseGeometry Center="12,12" RadiusX="9.4" RadiusY="7.6">
                                                <EllipseGeometry.Transform>
                                                    <RotateTransform Angle="-22" CenterX="12" CenterY="12" />
                                                </EllipseGeometry.Transform>
                                            </EllipseGeometry>
                                            </GeometryGroup>
                                        </Path.Data>
                                    </Path>
                                    <Path Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.78">
                                        <Path.Data>
                                            <GeometryGroup FillRule="EvenOdd">
                                            <EllipseGeometry Center="11.5,11.45" RadiusX="7.3" RadiusY="5.8">
                                                <EllipseGeometry.Transform>
                                                    <RotateTransform Angle="-22" CenterX="11.5" CenterY="11.45" />
                                                </EllipseGeometry.Transform>
                                            </EllipseGeometry>
                                            <EllipseGeometry Center="11.5,11.45" RadiusX="5.7" RadiusY="4.2">
                                                <EllipseGeometry.Transform>
                                                    <RotateTransform Angle="-22" CenterX="11.5" CenterY="11.45" />
                                                </EllipseGeometry.Transform>
                                            </EllipseGeometry>
                                            </GeometryGroup>
                                        </Path.Data>
                                    </Path>
                                    <Path Fill="{ThemeResource AccentFillColorDefaultBrush}">
                                        <Path.Data>
                                            <GeometryGroup>
                                            <EllipseGeometry Center="11,10.9" RadiusX="3" RadiusY="2.3">
                                                <EllipseGeometry.Transform>
                                                    <RotateTransform Angle="-22" CenterX="11" CenterY="10.9" />
                                                </EllipseGeometry.Transform>
                                            </EllipseGeometry>
                                            </GeometryGroup>
                                        </Path.Data>
                                    </Path>
                                    <!-- BRAND-MARK:END -->
                                </Grid>
                            </Viewbox>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="OpenEGo Hub" Style="{ThemeResource TitleTextBlockStyle}" />
                                <TextBlock x:Name="AboutVersionText"
                                           Style="{StaticResource SettingsDescriptionStyle}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="项目" Style="{StaticResource SettingsGroupHeaderStyle}" />
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid ColumnSpacing="12" RowSpacing="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <!-- GitHub Octicons: mark-github-16, MIT licensed. -->
                                    <Viewbox
                                        Grid.RowSpan="2"
                                        Width="28"
                                        Height="28"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <Path
                                            Width="16"
                                            Height="16"
                                            Stretch="Uniform"
                                            Fill="{ThemeResource TextFillColorPrimaryBrush}"
                                            Data="M8,0 C3.58,0 0,3.58 0,8 C0,11.54 2.29,14.53 5.47,15.59 C5.87,15.66 6.02,15.42 6.02,15.21 C6.02,15.02 6.01,14.39 6.01,13.72 C4,14.09 3.48,13.23 3.32,12.78 C3.23,12.55 2.84,11.84 2.5,11.65 C2.22,11.5 1.82,11.13 2.49,11.12 C3.12,11.11 3.57,11.7 3.72,11.94 C4.44,13.15 5.59,12.81 6.05,12.6 C6.12,12.08 6.33,11.73 6.56,11.53 C4.78,11.33 2.92,10.64 2.92,7.58 C2.92,6.71 3.23,5.99 3.74,5.43 C3.66,5.23 3.38,4.41 3.82,3.31 C3.82,3.31 4.49,3.1 6.02,4.13 C6.66,3.95 7.34,3.86 8.02,3.86 C8.7,3.86 9.38,3.95 10.02,4.13 C11.55,3.09 12.22,3.31 12.22,3.31 C12.66,4.41 12.38,5.23 12.3,5.43 C12.81,5.99 13.12,6.7 13.12,7.58 C13.12,10.65 11.25,11.33 9.47,11.53 C9.76,11.78 10.01,12.26 10.01,13.01 C10.01,14.08 10,14.94 10,15.21 C10,15.42 10.15,15.67 10.55,15.59 C13.71,14.53 16,11.53 16,8 C16,3.58 12.42,0 8,0 Z" />
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="GitHub" />
                                    <HyperlinkButton
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Content="NihilDigit/openego-hub"
                                        Padding="0"
                                        HorizontalAlignment="Left"
                                        NavigateUri="https://github.com/NihilDigit/openego-hub" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="许可" Style="{StaticResource SettingsGroupHeaderStyle}" />
                            <Border Style="{StaticResource SettingsCardCompactStyle}">
                                <!-- 两条横排。各占一行会在右边留下一大片空白，而它们本来就是
                                     并列的两个链接，不存在先后。 -->
                                <StackPanel Orientation="Horizontal" Spacing="20">
                                    <HyperlinkButton
                                        Content="MIT License"
                                        Padding="0"
                                        NavigateUri="https://github.com/NihilDigit/openego-hub/blob/main/LICENSE" />
                                    <HyperlinkButton
                                        Content="第三方许可与声明"
                                        Padding="0"
                                        NavigateUri="https://github.com/NihilDigit/openego-hub/blob/main/THIRD-PARTY-NOTICES.md" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="致谢" Style="{StaticResource SettingsGroupHeaderStyle}" />
                            <Border Style="{StaticResource SettingsCardCompactStyle}">
                                <!-- 链接嵌在句子里而不是一行一个：一行一个会在右边留下大片
                                     空白，而这些项目之间并无主次，本来就该并列成一句话。 -->
                                <!-- 致谢与声明取同一档字号，比页面上其余描述性文字大一号：
                                     这两段是给人读的句子，不是控件下面的一行注解。 -->
                                <RichTextBlock
                                    FontSize="14"
                                    LineHeight="22"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Paragraph>
                                        <Run Text="本项目的实现参考了这些优秀的开源项目：" />
                                        <Hyperlink NavigateUri="https://github.com/awarson2233/EGoTouchRev">EGoTouchRev</Hyperlink><Run Text="、" /><Hyperlink
                                            NavigateUri="https://github.com/matebook-e-go/goodies">goodies</Hyperlink><Run Text="、" /><Hyperlink
                                            NavigateUri="https://github.com/LanZhan-Harmony/HuaweiThpService">HuaweiThpService</Hyperlink><Run Text="、" /><Hyperlink
                                            NavigateUri="https://github.com/eiyooooo/MateBook-E-Pen">MateBook-E-Pen</Hyperlink><Run Text="、" /><Hyperlink
                                            NavigateUri="https://github.com/SaKongA/EgoTools">EgoTools</Hyperlink><Run Text="、" /><Hyperlink
                                            NavigateUri="https://github.com/qwqVictor/HuaweiPenEraserService">HuaweiPenEraserService</Hyperlink><Run Text="。" />
                                    </Paragraph>
                                </RichTextBlock>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="声明" Style="{StaticResource SettingsGroupHeaderStyle}" />
                            <Border Style="{StaticResource SettingsCardCompactStyle}">
                                <!-- 字号与上面的致谢取齐，见那里的说明。 -->
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Text="与 HUAWEI、Himax 及其商标持有者无关联。"
                                        FontSize="14"
                                        LineHeight="22"
                                        Style="{StaticResource SettingsDescriptionStyle}" />
                                    <TextBlock
                                        Text="设备产品图在运行时读取自本机的 PC Manager，不随本程序分发。"
                                        FontSize="14"
                                        LineHeight="22"
                                        Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
