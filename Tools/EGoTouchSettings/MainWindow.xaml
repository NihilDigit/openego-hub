                                        </Grid>
                                    </Border>

                                    <StackPanel x:Name="VendorServicesDetailsGroup" Visibility="Collapsed">
                                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                        <Border Padding="56,12,16,14"
                                                CornerRadius="0,0,7,7"
                                                Background="{ThemeResource LayerFillColorAltBrush}">
                                            <StackPanel Spacing="10">
                                                <StackPanel Spacing="8">
                                                    <Grid x:Name="VendorSvcRow0" ColumnSpacing="16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="96" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="电脑管家核心"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="HwPCCoreService"
                                                                   Style="{StaticResource SettingsDescriptionStyle}"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   IsTextSelectionEnabled="True"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock x:Name="VendorSvcState0"
                                                                   Grid.Column="2"
                                                                   Text="—"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>

                                                    <Grid x:Name="VendorSvcRow1" ColumnSpacing="16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="96" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="设备发现连接"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="HiConnectivityService"
                                                                   Style="{StaticResource SettingsDescriptionStyle}"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   IsTextSelectionEnabled="True"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock x:Name="VendorSvcState1"
                                                                   Grid.Column="2"
                                                                   Text="—"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>

                                                    <Grid x:Name="VendorSvcRow2" ColumnSpacing="16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="96" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="多屏协同"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="HwDistributedMainService"
                                                                   Style="{StaticResource SettingsDescriptionStyle}"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   IsTextSelectionEnabled="True"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock x:Name="VendorSvcState2"
                                                                   Grid.Column="2"
                                                                   Text="—"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>

                                                    <Grid x:Name="VendorSvcRow3" ColumnSpacing="16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="96" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="键鼠共享穿越"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="MouseCrossingDaemon"
                                                                   Style="{StaticResource SettingsDescriptionStyle}"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   IsTextSelectionEnabled="True"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock x:Name="VendorSvcState3"
                                                                   Grid.Column="2"
                                                                   Text="—"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>

                                                    <Grid x:Name="VendorSvcRow4" ColumnSpacing="16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="96" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="原厂色彩增强"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="LCD_Service"
                                                                   Style="{StaticResource SettingsDescriptionStyle}"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   IsTextSelectionEnabled="True"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock x:Name="VendorSvcState4"
                                                                   Grid.Column="2"
                                                                   Text="—"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>

                                                    <Grid x:Name="VendorSvcRow5" ColumnSpacing="16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="96" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="管家扩展服务"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="MBAMainService"
                                                                   Style="{StaticResource SettingsDescriptionStyle}"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   IsTextSelectionEnabled="True"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock x:Name="VendorSvcState5"
                                                                   Grid.Column="2"
                                                                   Text="—"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>

                                                    <Grid x:Name="VendorSvcRow6" ColumnSpacing="16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="96" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="后台升级代理"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="WUCSProxy"
                                                                   Style="{StaticResource SettingsDescriptionStyle}"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   IsTextSelectionEnabled="True"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock x:Name="VendorSvcState6"
                                                                   Grid.Column="2"
                                                                   Text="—"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </StackPanel>
                                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                                <TextBlock
                                                    Text="快捷键与麦克风指示灯所需的 HW_OSDServer 不在此列，保持原样运行。"
                                                    Style="{StaticResource SettingsDescriptionStyle}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- 只在启动类型已禁用、进程却还活着时出现。正常路径下停用会
                                 连进程一起收掉，这一条不会显示——所以它不是「改完要重启」
                                 那种常规提示，出现了就说明有东西没收干净。 -->
                            <InfoBar
                                x:Name="VendorServicesRestartBar"
                                IsOpen="False"
                                IsClosable="False"
                                Severity="Warning"
                                Title="有服务仍在运行"
                                Message="已设为禁用，但有进程没有退出。重启后不会再启动。" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="启动与运行" Style="{StaticResource SettingsGroupHeaderStyle}" />
                            <Border Style="{StaticResource SettingsCompoundCardStyle}">
                                <StackPanel>
                                    <Border Style="{StaticResource SettingsCompoundRowStyle}">
                                        <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- EA8F 是 Ringer，一个描边铃铛。这一列其余几个都是描边字形，
                                                 而 E7E7（ActionCenterNotification）是实心横幅，混在里面很扎眼。 -->
                                            <FontIcon Glyph="&#xEA8F;" Style="{StaticResource SettingsRowIconStyle}" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="设备提示弹窗" TextWrapping="Wrap" />
                                                <TextBlock
                                                    Text="手写笔或键盘接入时显示提示。"
                                                    Style="{StaticResource SettingsDescriptionStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch
                                                x:Name="DeviceNotificationsToggle"
                                                Grid.Column="2"
                                                MinWidth="0"
                                                OnContent=""
                                                OffContent=""
                                                Margin="0,0,-12,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="设备提示弹窗"
                                                Toggled="DeviceNotificationsToggled" />
                                        </Grid>
                                    </Border>

                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                    <Border Style="{StaticResource SettingsCompoundRowStyle}">
                                        <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE768;" Style="{StaticResource SettingsRowIconStyle}" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="登录后自动启用" TextWrapping="Wrap" />
                                                <TextBlock
                                                    Text="登录 Windows 后启动托盘并接管触控。"
                                                    Style="{StaticResource SettingsDescriptionStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch
                                                x:Name="AutoStartToggle"
                                                Grid.Column="2"
                                                MinWidth="0"
                                                OnContent=""
                                                OffContent=""
                                                Margin="0,0,-12,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="登录后自动启用"
                                                Toggled="AutoStartToggled" />
                                        </Grid>
                                    </Border>

                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                    <Border Style="{StaticResource SettingsCompoundRowStyle}">
                                        <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- E7E8 是 PowerButton。原先用的 E7E7 是 ActionCenterNotification，
                                                 一个通知中心图标，与退出毫无关系。 -->
                                            <FontIcon Glyph="&#xE7E8;" Style="{StaticResource SettingsRowIconStyle}" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="退出并交还原厂" TextWrapping="Wrap" />
                                                <TextBlock
                                                    Text="触控与手写笔交还华为驱动，并关闭托盘。"
                                                    Style="{StaticResource SettingsDescriptionStyle}" />
                                            </StackPanel>
                                            <Button
                                                x:Name="ExitButton"
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Content="退出"
                                                AutomationProperties.Name="退出并交还原厂"
                                                Click="ExitClicked" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ── 设备页 ── -->
                <ScrollViewer
                    x:Name="DevicePage"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Padding="24,8,24,24" Spacing="24">

                        <!-- 整机图取自本机键盘插件里的 snapping.png，见 AccessoryImages::ResolveMachine。
                             机型名用 SMBIOS 的 Family 字段，固件里写的就是「MateBook E」，
                             不需要自己维护型号码到营销名的映射。 -->
                        <!-- 这一段也装进卡片，与页面上其余各段一致。整机图是深灰的，摊在页面
                             底色上时深色主题里几乎看不出边界，卡片的底色和描边正好把它托住。 -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="MachineNameText"
                                        Text="本机"
                                        Style="{ThemeResource TitleTextBlockStyle}" />
                                    <TextBlock
                                        x:Name="MachineIdentityText"
                                        Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <Image
                                    x:Name="MachineImage"
                                    Grid.Column="1"
                                    Width="120"
                                    Height="120"
                                    Stretch="Uniform"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 硬件 -->
                        <StackPanel Spacing="4">
                            <StackPanel Style="{StaticResource GroupHeaderRowStyle}">
                                <FontIcon Glyph="&#xE977;" Style="{StaticResource SpecGroupIconStyle}" />
                                <TextBlock Text="硬件" Style="{StaticResource SpecGroupTitleStyle}" />
                            </StackPanel>
                            <Border Style="{StaticResource SettingsCardCompactStyle}">
                                <!-- 整卡一个网格，长值跨列。分成几个各自独立的 Grid 会让列宽
                                     各算各的，值的起始位置对不齐——三行看起来像三段。 -->
                                <Grid ColumnSpacing="16" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" MinWidth="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="处理器"
                                               Style="{StaticResource SettingsDescriptionStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DeviceProcessorText"
                                               TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="核心"
                                               Style="{StaticResource SettingsDescriptionStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="3" x:Name="DeviceCoresText"
                                               TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="内存"
                                               Style="{StaticResource SettingsDescriptionStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DeviceMemoryText"
                                               TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="屏幕"
                                               Style="{StaticResource SettingsDescriptionStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" x:Name="DeviceDisplayText"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- 系统 -->
                        <StackPanel Spacing="4">
                            <StackPanel Style="{StaticResource GroupHeaderRowStyle}">
                                <!-- Windows 11 的标记：四个等大的圆角方块。自己画而不是找字形，
                                     Segoe Fluent 里没有可靠的 Windows 标记，用别的图标顶替
                                     反而看不出这一栏讲的是操作系统。
                                     颜色跟着其余分组图标走次要色，不用品牌蓝——这里要的是
                                     指代而不是强调。 -->
                                <!-- 13 而不是跟 FontIcon 一样的 15：字形本身带留白，实心方块
                                     占满整个尺寸，同样数值下看起来会大一圈。 -->
                                <Viewbox Width="13" Height="13" VerticalAlignment="Center">
                                    <Grid Width="16" Height="16" ColumnSpacing="1.8" RowSpacing="1.8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Rectangle Grid.Row="0" Grid.Column="0" RadiusX="0.8" RadiusY="0.8"
                                                   Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Rectangle Grid.Row="0" Grid.Column="1" RadiusX="0.8" RadiusY="0.8"
                                                   Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Rectangle Grid.Row="1" Grid.Column="0" RadiusX="0.8" RadiusY="0.8"
                                                   Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Rectangle Grid.Row="1" Grid.Column="1" RadiusX="0.8" RadiusY="0.8"
                                                   Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </Viewbox>
                                <TextBlock Text="系统" Style="{StaticResource SpecGroupTitleStyle}" />
                            </StackPanel>
                            <Border Style="{StaticResource SettingsCardCompactStyle}">
                                <Grid ColumnSpacing="16" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Windows"
                                               Style="{StaticResource SettingsDescriptionStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DeviceOsText"
                                               TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="BIOS"
                                               Style="{StaticResource SettingsDescriptionStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DeviceBiosText"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- 标识 -->
                        <StackPanel Spacing="4">
                            <StackPanel Style="{StaticResource GroupHeaderRowStyle}">
                                <FontIcon Glyph="&#xE946;" Style="{StaticResource SpecGroupIconStyle}" />
                                <TextBlock Text="标识" Style="{StaticResource SpecGroupTitleStyle}" />
                            </StackPanel>
                            <Border Style="{StaticResource SettingsCardCompactStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" MinWidth="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="序列号" Style="{StaticResource SettingsDescriptionStyle}" />
                                    <TextBlock
                                        x:Name="DeviceSerialText"
                                        Grid.Column="1"
                                        IsTextSelectionEnabled="True"
                                        TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="2" Text="配置"
                                               Style="{StaticResource SettingsDescriptionStyle}" />
                                    <TextBlock Grid.Column="3" x:Name="DeviceSkuText" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ── 关于页 ── -->
                <ScrollViewer
                    x:Name="AboutPage"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="AboutLayoutGrid"
                          Padding="24,8,24,24"
                          ColumnSpacing="20"
                          RowSpacing="24"
                          SizeChanged="AboutLayoutGridSizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="AboutCol0" Width="6*" />
                            <ColumnDefinition x:Name="AboutCol1" Width="5*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 左栏：品牌、版本与更新、诊断日志 -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="20">
                            <!-- 关于页是标记唯一以完整三层出现的地方。这里不缩到图标尺寸，
                                 层与层之间的明暗差正是它要表达的东西：一个接触点在电容图上
                                 由强到弱的等高线。 -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="版本与更新" Style="{StaticResource SettingsGroupHeaderStyle}" />
                                <Border Style="{StaticResource SettingsCompoundCardStyle}">
                                    <StackPanel>
                                        <Border Padding="20,18">
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                            <Viewbox Width="48" Height="48" VerticalAlignment="Center">
                                <Grid Width="24" Height="24">
                                    <!-- BRAND-MARK:BEGIN -->
                                    <!-- 由 scripts/make_brand_assets.py 从 Assets/brand/openego-hub.svg 生成，不要手改。 -->
                                    <Path Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.5">
                                        <Path.Data>
                                            <GeometryGroup FillRule="EvenOdd">
                                            <EllipseGeometry Center="12,12" RadiusX="11" RadiusY="9.2">
                                                <EllipseGeometry.Transform>
                                                    <RotateTransform Angle="-22" CenterX="12" CenterY="12" />
                                                </EllipseGeometry.Transform>
                                            </EllipseGeometry>
                                            <EllipseGeometry Center="12,12" RadiusX="9.4" RadiusY="7.6">
                                                <EllipseGeometry.Transform>
                                                    <RotateTransform Angle="-22" CenterX="12" CenterY="12" />
                                                </EllipseGeometry.Transform>
                                            </EllipseGeometry>
                                            </GeometryGroup>
                                        </Path.Data>
                                    </Path>
                                    <Path Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.78">
                                        <Path.Data>
                                            <GeometryGroup FillRule="EvenOdd">
                                            <EllipseGeometry Center="11.5,11.45" RadiusX="7.3" RadiusY="5.8">
                                                <EllipseGeometry.Transform>
                                                    <RotateTransform Angle="-22" CenterX="11.5" CenterY="11.45" />
                                                </EllipseGeometry.Transform>
                                            </EllipseGeometry>
                                            <EllipseGeometry Center="11.5,11.45" RadiusX="5.7" RadiusY="4.2">
                                                <EllipseGeometry.Transform>
                                                    <RotateTransform Angle="-22" CenterX="11.5" CenterY="11.45" />
                                                </EllipseGeometry.Transform>
                                            </EllipseGeometry>
                                            </GeometryGroup>
                                        </Path.Data>
                                    </Path>
                                    <Path Fill="{ThemeResource AccentFillColorDefaultBrush}">
                                        <Path.Data>
                                            <GeometryGroup>
                                            <EllipseGeometry Center="11,10.9" RadiusX="3" RadiusY="2.3">
                                                <EllipseGeometry.Transform>
                                                    <RotateTransform Angle="-22" CenterX="11" CenterY="10.9" />
                                                </EllipseGeometry.Transform>
                                            </EllipseGeometry>
                                            </GeometryGroup>
                                        </Path.Data>
                                    </Path>
                                    <!-- BRAND-MARK:END -->
                                </Grid>
                            </Viewbox>
                                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                        <TextBlock Text="OpenEGo Hub"
                                                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                                                   VerticalAlignment="Center" />
                                                        <Border CornerRadius="4"
                                                                Padding="8,2"
                                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                VerticalAlignment="Center">
                                                            <TextBlock x:Name="AboutVersionText"
                                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="HUAWEI MateBook E Go 硬件控制中心"
                                                               Style="{StaticResource SettingsDescriptionStyle}" />
                                                    <TextBlock x:Name="UpdateStatusText"
                                                               Text="已是最新版本。"
                                                               Style="{StaticResource SettingsDescriptionStyle}" />
                                                </StackPanel>
                                                <ProgressRing
                                                    x:Name="UpdateCheckProgress"
                                                    Grid.Column="2"
                                                    Width="16"
                                                    Height="16"
                                                    IsActive="False"
                                                    Visibility="Collapsed"
                                                    VerticalAlignment="Center" />
                                                <Button
                                                    x:Name="UpdateCheckButton"
                                                    Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    Content="检查更新"
                                                    AutomationProperties.Name="检查更新"
                                                    Click="CheckForUpdatesClicked" />
                                            </Grid>
                                        </Border>

                                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                        <Border Style="{StaticResource SettingsCompoundRowStyle}">
                                            <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- E895 是 Sync，系统设置里的「Windows 更新」用的也是它。 -->
                                                <FontIcon Glyph="&#xE895;" Style="{StaticResource SettingsRowIconStyle}" />
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="自动检查更新" TextWrapping="Wrap" />
                                                    <TextBlock Text="在后台定期检查新版本并提示升级。"
                                                               Style="{StaticResource SettingsDescriptionStyle}" />
                                                </StackPanel>
                                                <ToggleSwitch
                                                    x:Name="AutoUpdateCheckToggle"
                                                    Grid.Column="2"
                                                    MinWidth="0"
                                                    OnContent=""
                                                    OffContent=""
                                                    Margin="0,0,-12,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="自动检查更新"
                                                    Toggled="AutoUpdateCheckToggled" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="诊断" Style="{StaticResource SettingsGroupHeaderStyle}" />
                                <Border Style="{StaticResource SettingsCompoundCardStyle}">
                                    <StackPanel>
                                        <Border Style="{StaticResource SettingsCompoundRowStyle}">
                                            <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="&#xE896;" Style="{StaticResource SettingsRowIconStyle}" />
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="运行日志" TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Text="打包服务与各硬件宿主的日志，随问题反馈一并提交。"
                                                        Style="{StaticResource SettingsDescriptionStyle}" />
                                                </StackPanel>
                                                <ProgressRing
                                                    x:Name="ExportLogsProgress"
                                                    Grid.Column="2"
                                                    Width="16"
                                                    Height="16"
                                                    IsActive="False"
                                                    Visibility="Collapsed"
                                                    VerticalAlignment="Center" />
                                                <Button
                                                    x:Name="ExportLogsButton"
                                                    Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    Content="导出日志"
                                                    AutomationProperties.Name="导出运行日志"
                                                    Click="ExportLogsClicked" />
                                            </Grid>
                                        </Border>
                                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                        <!-- 默认关闭：厂商日志按天分文件，目录里常年堆着上百 MB，而绝大多数
                                             反馈用不到它。只有触控本身不工作时，原因才只存在于那份日志里。 -->
                                        <Border Style="{StaticResource SettingsCompoundRowStyle}">
                                            <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="&#xE7C3;" Style="{StaticResource SettingsRowIconStyle}" />
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="附带厂商日志" TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Text="触摸或笔不工作时，原因通常记录在华为触控服务的日志里。文件较大，默认不附带。"
                                                        Style="{StaticResource SettingsDescriptionStyle}" />
                                                </StackPanel>
                                                <ToggleSwitch
                                                    x:Name="ExportVendorLogsToggle"
                                                    Grid.Column="2"
                                                    MinWidth="0"
                                                    OnContent=""
                                                    OffContent=""
                                                    Margin="0,0,-12,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="附带厂商日志"
                                                    IsOn="False" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <!-- 结果不走顶部那条 StatusInfoBar：那一条播报的是托盘连接状态，
                                     每次刷新都会重写，导出的结果会被下一个 tick 抹掉。 -->
                                <InfoBar
                                    x:Name="ExportLogsBar"
                                    IsOpen="False"
                                    IsClosable="True"
                                    Severity="Informational">
                                    <InfoBar.ActionButton>
                                        <Button
                                            x:Name="ExportLogsRevealButton"
                                            Content="打开所在文件夹"
                                            Visibility="Collapsed"
                                            Click="ExportLogsRevealClicked" />
                                    </InfoBar.ActionButton>
                                </InfoBar>
                            </StackPanel>
                        </StackPanel>

                        <!-- 右栏：开源项目与社区致谢（宽屏并列，窄屏落入下方） -->
