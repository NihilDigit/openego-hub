                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE765;" Style="{StaticResource SettingsRowIconStyle}" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="分离后保持无线连接" TextWrapping="Wrap" />
                                                <TextBlock x:Name="HomeKeyboardStatusText"
                                                           Text="键盘与主机分离后继续通过无线方式使用。"
                                                           Style="{StaticResource SettingsDescriptionStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch x:Name="HomeKeyboardWirelessToggle"
                                                          Grid.Column="2"
                                                          MinWidth="0"
                                                          OnContent=""
                                                          OffContent=""
                                                          Margin="0,0,-12,0"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          AutomationProperties.Name="分离后保持无线连接"
                                                          Toggled="KeyboardWirelessToggled" />
                                        </Grid>
                                    </Border>

                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                    <Border Style="{StaticResource SettingsCompoundRowStyle}">
                                        <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE7B3;" Style="{StaticResource SettingsRowIconStyle}" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="护眼模式" TextWrapping="Wrap" />
                                                <TextBlock x:Name="HomeScreenSummaryText"
                                                           Text="减弱屏幕蓝光。"
                                                           Style="{StaticResource SettingsDescriptionStyle}" />
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    Content="显示设置"
                                                    Tag="screen"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="显示设置"
                                                    Click="HomeNavCardClicked" />
                                            <ToggleSwitch x:Name="HomeEyeComfortToggle"
                                                          Grid.Column="3"
                                                          MinWidth="0"
                                                          OnContent=""
                                                          OffContent=""
                                                          Margin="0,0,-12,0"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          AutomationProperties.Name="护眼模式"
                                                          Toggled="EyeComfortToggled" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ── 配件页 ── -->
                <ScrollViewer
                    x:Name="DevicesPage"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Padding="24,8,24,24" Spacing="24">
                        <InfoBar
                            x:Name="AccessoryVendorMissingBar"
                            Visibility="Collapsed"
                            IsOpen="False"
                            IsClosable="False"
                            Severity="Warning"
                            Title="未找到电脑管家的配件组件"
                            Message="配件状态依赖华为电脑管家自带的组件，当前未能加载，电量与固件信息不可用。重新安装华为电脑管家后会自动恢复。" />
                        <Border x:Name="DeviceEmptyState"
                                Style="{StaticResource SettingsCardCompactStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <FontIcon x:Name="DeviceEmptyStateIcon" Glyph="&#xE946;" FontSize="20"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock x:Name="DeviceEmptyStateText" Text="未接入笔或键盘"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- 手写笔：设备状态与关联设置合并在同一对称复合卡片内 -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="手写笔" Style="{StaticResource SettingsGroupHeaderStyle}" />
                            <Border Style="{StaticResource SettingsCompoundCardStyle}">
                                <StackPanel>
                                    <StackPanel x:Name="PenHeaderSection" Visibility="Collapsed">
                                        <Border Padding="20,18" MinHeight="92">
                                            <Grid ColumnSpacing="20">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="168"
                                                      Height="36"
                                                      VerticalAlignment="Center">
                                                    <Image x:Name="PenImage"
                                                           Stretch="Uniform"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="Collapsed" />
                                                    <FontIcon x:Name="PenImageFallback"
                                                              Glyph="&#xE70F;"
                                                              FontSize="22"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                </Grid>
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock x:Name="PenNameText"
                                                               Text="HUAWEI M-Pencil"
                                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock x:Name="PenStateText"
                                                               Text="未连接"
                                                               Style="{StaticResource SettingsDescriptionStyle}" />
                                                </StackPanel>
                                                <Grid Grid.Column="2" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Name="PenDetailsToggleButton"
                                                            Grid.Column="0"
                                                            Visibility="Collapsed"
                                                            Margin="0,0,12,0"
                                                            MinWidth="34"
                                                            MinHeight="32"
                                                            Padding="10,6"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            CornerRadius="{ThemeResource ControlCornerRadius}"
                                                            VerticalAlignment="Center"
                                                            AutomationProperties.Name="手写笔详细信息"
                                                            Click="PenDetailsToggleClicked">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <TextBlock Text="详细信息" Style="{StaticResource SettingsDescriptionStyle}" />
                                                            <FontIcon x:Name="PenDetailsChevron"
                                                                      Glyph="&#xE70D;"
                                                                      FontSize="12"
                                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                                        <local:BatteryIndicator x:Name="PenBatteryIndicator"
                                                                                HorizontalAlignment="Right"
                                                                                VerticalAlignment="Center" />
                                                        <Button x:Name="PenDismissButton"
                                                                Visibility="Collapsed"
                                                                MinWidth="34"
                                                                MinHeight="34"
                                                                Padding="8"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                AutomationProperties.Name="移除手写笔卡片"
                                                                ToolTipService.ToolTip="移除"
                                                                Click="PenDismissClicked">
                                                            <FontIcon Glyph="&#xE711;" FontSize="12"
                                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </Button>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <StackPanel x:Name="PenIdentityGroup" Visibility="Collapsed">
                                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                            <Border Padding="16,12" Background="{ThemeResource LayerFillColorAltBrush}">
                                                <StackPanel Spacing="8">
                                                    <Grid x:Name="PenFirmwareRow" ColumnSpacing="16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" MinWidth="72" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="固件版本" Style="{StaticResource DeviceFieldLabelStyle}" />
                                                        <TextBlock x:Name="PenFirmwareText" Grid.Column="1"
                                                                   Style="{StaticResource DeviceFieldValueStyle}" />
                                                    </Grid>
                                                    <Grid x:Name="PenHardwareRow" ColumnSpacing="16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" MinWidth="72" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="硬件版本" Style="{StaticResource DeviceFieldLabelStyle}" />
                                                        <TextBlock x:Name="PenHardwareText" Grid.Column="1"
                                                                   Style="{StaticResource DeviceFieldValueStyle}" />
                                                    </Grid>
                                                    <Grid x:Name="PenSerialRow" ColumnSpacing="16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" MinWidth="72" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="序列号" Style="{StaticResource DeviceFieldLabelStyle}" />
                                                        <TextBlock x:Name="PenSerialText" Grid.Column="1"
                                                                   Style="{StaticResource DeviceFieldValueStyle}"
                                                                   IsTextSelectionEnabled="True" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    </StackPanel>

                                    <Border Style="{StaticResource SettingsCompoundRowStyle}">
                                        <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE70F;" Style="{StaticResource SettingsRowIconStyle}" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="双击行为" TextWrapping="Wrap" />
                                                <TextBlock
                                                    Text="选择连按两次笔侧键时执行的操作。"
                                                    Style="{StaticResource SettingsDescriptionStyle}" />
                                            </StackPanel>
                                            <ComboBox
                                                x:Name="PenModeSelector"
                                                Grid.Column="2"
                                                MinWidth="180"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="双击行为"
                                                SelectionChanged="PenModeSelectionChanged">
                                                <ComboBoxItem Content="遵循系统笔设置" />
                                                <ComboBoxItem Content="切换书写与橡皮擦" />
                                            </ComboBox>
                                        </Grid>
                                    </Border>
                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Border x:Name="OneNoteCompatibilityRow" Style="{StaticResource SettingsCompoundRowStyle}">
                                        <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE70B;" Style="{StaticResource SettingsRowIconStyle}" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="OneNote 兼容" TextWrapping="Wrap" />
                                                <TextBlock
                                                    x:Name="OneNoteCompatibilityStatusText"
                                                    Text="切换工具时同步 OneNote 的绘图选项。"
                                                    Style="{StaticResource SettingsDescriptionStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch
                                                x:Name="OneNoteCompatibilityToggle"
                                                Grid.Column="2"
                                                MinWidth="0"
                                                OnContent=""
                                                OffContent=""
                                                Margin="0,0,-12,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="OneNote 兼容"
                                                Toggled="OneNoteCompatibilityToggled" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 键盘：设备状态与关联设置合并在同一对称复合卡片内 -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="键盘" Style="{StaticResource SettingsGroupHeaderStyle}" />
                            <Border Style="{StaticResource SettingsCompoundCardStyle}">
                                <StackPanel>
                                    <StackPanel x:Name="KeyboardHeaderSection" Visibility="Collapsed">
                                        <Border Padding="20,16" MinHeight="104">
                                            <Grid ColumnSpacing="20">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="116"
                                                      Height="80"
                                                      VerticalAlignment="Center">
                                                    <Image x:Name="KeyboardImage"
                                                           Stretch="Uniform"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="Collapsed" />
                                                    <FontIcon x:Name="KeyboardImageFallback"
                                                              Glyph="&#xE765;"
                                                              FontSize="24"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                </Grid>
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock x:Name="KeyboardNameText"
                                                               Text="HUAWEI 智能磁吸键盘"
                                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock x:Name="KeyboardStateText"
                                                               Text="未检测到键盘"
                                                               Style="{StaticResource SettingsDescriptionStyle}" />
                                                </StackPanel>
                                                <Grid Grid.Column="2" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Name="KeyboardDetailsToggleButton"
                                                            Grid.Column="0"
                                                            Visibility="Collapsed"
                                                            Margin="0,0,12,0"
                                                            MinWidth="34"
                                                            MinHeight="32"
                                                            Padding="10,6"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            CornerRadius="{ThemeResource ControlCornerRadius}"
                                                            VerticalAlignment="Center"
                                                            AutomationProperties.Name="键盘详细信息"
                                                            Click="KeyboardDetailsToggleClicked">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <TextBlock Text="详细信息" Style="{StaticResource SettingsDescriptionStyle}" />
                                                            <FontIcon x:Name="KeyboardDetailsChevron"
                                                                      Glyph="&#xE70D;"
                                                                      FontSize="12"
                                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                                        <local:BatteryIndicator x:Name="KeyboardBatteryIndicator"
                                                                                HorizontalAlignment="Right"
                                                                                VerticalAlignment="Center" />
                                                        <Button x:Name="KeyboardDismissButton"
                                                                Visibility="Collapsed"
                                                                MinWidth="34"
                                                                MinHeight="34"
                                                                Padding="8"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                AutomationProperties.Name="移除键盘卡片"
                                                                ToolTipService.ToolTip="移除"
                                                                Click="KeyboardDismissClicked">
                                                            <FontIcon Glyph="&#xE711;" FontSize="12"
                                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </Button>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <StackPanel x:Name="KeyboardIdentityGroup" Visibility="Collapsed">
                                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                            <Border Padding="16,12" Background="{ThemeResource LayerFillColorAltBrush}">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" MinWidth="72" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="固件版本" Style="{StaticResource DeviceFieldLabelStyle}" />
                                                    <TextBlock x:Name="KeyboardFirmwareText" Grid.Column="1"
                                                               Style="{StaticResource DeviceFieldValueStyle}" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    </StackPanel>

                                    <Border Style="{StaticResource SettingsCompoundRowStyle}">
                                        <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE765;" Style="{StaticResource SettingsRowIconStyle}" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="分离后保持无线连接" TextWrapping="Wrap" />
                                                <TextBlock
                                                    x:Name="KeyboardStatusText"
                                                    Text="键盘与主机分离后继续通过无线方式使用。"
                                                    Style="{StaticResource SettingsDescriptionStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch
                                                x:Name="KeyboardWirelessToggle"
                                                Grid.Column="2"
                                                MinWidth="0"
                                                OnContent=""
                                                OffContent=""
                                                Margin="0,0,-12,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="分离后保持无线连接"
                                                Toggled="KeyboardWirelessToggled" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ── 电池页 ── -->
                <ScrollViewer
                    x:Name="BatteryPage"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="BatteryLayoutGrid"
                          Padding="24,8,24,24"
                          ColumnSpacing="20"
                          RowSpacing="24"
                          SizeChanged="BatteryLayoutGridSizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="BatteryCol0" Width="6*" />
                            <ColumnDefinition x:Name="BatteryCol1" Width="5*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 左栏：节能与性能、充电保护 -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="20">
                            <StackPanel Spacing="4">
                                <TextBlock Text="节能与性能" Style="{StaticResource SettingsGroupHeaderStyle}" />
                                <Border Style="{StaticResource SettingsCompoundCardStyle}">
                                    <StackPanel>
                                        <Border Style="{StaticResource SettingsCompoundRowStyle}">
                                            <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="&#xEC0A;" Style="{StaticResource SettingsRowIconStyle}" />
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="节能模式" TextWrapping="Wrap" />
                                                    <TextBlock
                                                        x:Name="EnergySaverStatusText"
                                                        Text="开启后降低后台活动与部分视觉效果，以延长电池续航。"
                                                        Style="{StaticResource SettingsDescriptionStyle}" />
                                                </StackPanel>
                                                <ToggleSwitch
                                                    x:Name="EnergySaverToggle"
                                                    Grid.Column="2"
                                                    MinWidth="0"
                                                    OnContent=""
                                                    OffContent=""
                                                    Margin="0,0,-12,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="节能模式"
                                                    Toggled="EnergySaverToggled" />
                                            </Grid>
                                        </Border>

                                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                        <Border Style="{StaticResource SettingsCompoundRowStyle}">
                                            <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="&#xEBB6;" Style="{StaticResource SettingsRowIconStyle}" />
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="自动开启节能模式" TextWrapping="Wrap" />
                                                    <TextBlock
                                                        x:Name="EnergySaverThresholdStatusText"
                                                        Text="使用电池且电量低于此阈值时自动开启。"
                                                        Style="{StaticResource SettingsDescriptionStyle}" />
                                                </StackPanel>
                                                <ComboBox
                                                    x:Name="EnergySaverThresholdCombo"
                                                    Grid.Column="2"
                                                    MinWidth="128"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="自动开启节能模式"
                                                    SelectionChanged="EnergySaverThresholdSelectionChanged">
                                                    <ComboBoxItem Content="从不" />
                                                    <ComboBoxItem Content="10%" />
                                                    <ComboBoxItem Content="20%" />
                                                    <ComboBoxItem Content="30%" />
                                                    <ComboBoxItem Content="40%" />
                                                    <ComboBoxItem Content="50%" />
                                                    <ComboBoxItem Content="始终" />
                                                </ComboBox>
                                            </Grid>
                                        </Border>

                                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                        <Border Style="{StaticResource SettingsCompoundRowStyle}">
                                            <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="&#xE706;" Style="{StaticResource SettingsRowIconStyle}" />
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="节能时降低屏幕亮度" TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Text="开启节能模式后自动调低屏幕背光以进一步省电。"
                                                        Style="{StaticResource SettingsDescriptionStyle}" />
                                                </StackPanel>
                                                <ToggleSwitch
                                                    x:Name="EnergySaverBrightnessToggle"
                                                    Grid.Column="2"
                                                    MinWidth="0"
                                                    OnContent=""
                                                    OffContent=""
                                                    Margin="0,0,-12,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="节能时降低屏幕亮度"
                                                    Toggled="EnergySaverBrightnessToggled" />
                                            </Grid>
                                        </Border>

                                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                        <Border Style="{StaticResource SettingsCompoundRowStyle}">
                                            <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="&#xEC4A;" Style="{StaticResource SettingsRowIconStyle}" />
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="电源模式" TextWrapping="Wrap" />
                                                    <TextBlock
                                                        x:Name="PowerModeStatusText"
                                                        Text="调节系统在电池续航与性能释放之间的取向。"
                                                        Style="{StaticResource SettingsDescriptionStyle}" />
                                                </StackPanel>
                                                <ComboBox
                                                    x:Name="PowerModeCombo"
                                                    Grid.Column="2"
                                                    MinWidth="128"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="电源模式"
                                                    SelectionChanged="PowerModeSelectionChanged">
                                                    <ComboBoxItem Content="最佳能效" />
                                                    <ComboBoxItem Content="平衡" />
                                                    <ComboBoxItem Content="最佳性能" />
                                                </ComboBox>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="充电保护" Style="{StaticResource SettingsGroupHeaderStyle}" />
                                <Border Style="{StaticResource SettingsCompoundCardStyle}">
                                    <StackPanel>
                                        <Border Style="{StaticResource SettingsCompoundRowStyle}">
                                            <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="&#xE945;" Style="{StaticResource SettingsRowIconStyle}" />
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="智能充电" TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Text="连续接电 72 小时后，把电量维持在 70%。"
                                                        Style="{StaticResource SettingsDescriptionStyle}" />
                                                </StackPanel>
                                                <ToggleSwitch
                                                    x:Name="SmartChargeToggle"
                                                    Grid.Column="2"
                                                    MinWidth="0"
                                                    OnContent=""
                                                    OffContent=""
                                                    Margin="0,0,-12,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="智能充电"
                                                    Toggled="SmartChargeToggled" />
                                            </Grid>
                                        </Border>

                                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                        <Border Style="{StaticResource SettingsCompoundRowStyle}">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xE83E;" Style="{StaticResource SettingsRowIconStyle}" />
                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="充电上限" TextWrapping="Wrap" />
                                                        <TextBlock
                                                            x:Name="ChargeLimitStatusText"
                                                            Text="长期插电时限制充电上限可以减缓电池老化。"
                                                            Style="{StaticResource SettingsDescriptionStyle}" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        x:Name="ChargeLimitValueText"
                                                        Grid.Column="2"
                                                        Text="100%"
                                                        MinWidth="44"
                                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center" />
                                                </Grid>
                                                <StackPanel
                                                    x:Name="ChargeLimitPresetsRow"
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    Margin="40,0,0,0">
                                                    <Button x:Name="ChargeLimitPreset70Btn"
                                                            Content="70%"
                                                            Tag="70"
                                                            Padding="10,4"
                                                            Click="ChargeLimitPresetClicked" />
                                                    <Button x:Name="ChargeLimitPreset80Btn"
                                                            Content="80%"
                                                            Tag="80"
                                                            Padding="10,4"
                                                            Click="ChargeLimitPresetClicked" />
                                                    <Button x:Name="ChargeLimitPreset90Btn"
                                                            Content="90%"
                                                            Tag="90"
                                                            Padding="10,4"
                                                            Click="ChargeLimitPresetClicked" />
                                                    <Button x:Name="ChargeLimitPreset100Btn"
                                                            Content="100%"
                                                            Tag="100"
                                                            Padding="10,4"
                                                            Click="ChargeLimitPresetClicked" />
                                                </StackPanel>
                                                <Grid ColumnSpacing="12" Margin="40,0,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="50%"
                                                               VerticalAlignment="Center"
                                                               Style="{StaticResource SettingsDescriptionStyle}" />
                                                    <Slider
                                                        x:Name="ChargeLimitSlider"
                                                        Grid.Column="1"
                                                        Minimum="50"
                                                        Maximum="100"
                                                        StepFrequency="10"
                                                        TickFrequency="10"
                                                        TickPlacement="Outside"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="充电上限"
                                                        ValueChanged="ChargeLimitChanged" />
                                                    <TextBlock Text="100%"
                                                               Grid.Column="2"
                                                               VerticalAlignment="Center"
                                                               Style="{StaticResource SettingsDescriptionStyle}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- 右栏：实时状态、健康与规格（宽屏并列，窄屏落入下方） -->
                        <StackPanel x:Name="BatterySidePanel" Grid.Row="0" Grid.Column="1" Spacing="20">
                            <StackPanel Spacing="4">
                                <TextBlock Text="实时状态" Style="{StaticResource SettingsGroupHeaderStyle}" />
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                <TextBlock
                                                    x:Name="BatteryPercentText"
                                                    Text="—"
                                                    Style="{ThemeResource TitleLargeTextBlockStyle}" />
                                                <TextBlock
                                                    x:Name="BatteryStateText"
                                                    Text="正在读取"
                                                    VerticalAlignment="Bottom"
                                                    Margin="0,0,0,6"
                                                    Style="{StaticResource SettingsDescriptionStyle}" />
                                            </StackPanel>
                                            <local:BatteryIndicator
                                                x:Name="BatteryHeroIcon"
                                                Grid.Column="1"
                                                VerticalAlignment="Center" />
                                        </Grid>

                                        <ProgressBar
                                            x:Name="BatteryLevelBar"
                                            Minimum="0"
                                            Maximum="100"
                                            Value="0" />

                                        <TextBlock
                                            x:Name="BatteryTimeText"
                                            Visibility="Collapsed"
                                            Style="{StaticResource SettingsDescriptionStyle}" />

                                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                        <Grid ColumnSpacing="16" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="60" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" MinWidth="60" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="供电来源"
                                                       Style="{StaticResource SettingsDescriptionStyle}" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="BatteryPowerSourceText"
                                                       Text="—" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="实时功耗"
                                                       Style="{StaticResource SettingsDescriptionStyle}" />
                                            <TextBlock Grid.Row="0" Grid.Column="3" x:Name="BatteryLivePowerText"
                                                       Text="—" TextTrimming="CharacterEllipsis" />

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="剩余容量"
                                                       Style="{StaticResource SettingsDescriptionStyle}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="BatteryRemainingCapText"
                                                       Text="—" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="当前电压"
                                                       Style="{StaticResource SettingsDescriptionStyle}" />
                                            <TextBlock Grid.Row="1" Grid.Column="3" x:Name="BatteryVoltageText"
                                                       Text="—" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="健康与规格" Style="{StaticResource SettingsGroupHeaderStyle}" />
                                <Border Style="{StaticResource SettingsCardCompactStyle}">
                                    <Grid ColumnSpacing="16" RowSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="64" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" MinWidth="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="健康度"
                                                   Style="{StaticResource SettingsDescriptionStyle}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="BatteryHealthText"
                                                   Text="—" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="循环次数"
                                                   Style="{StaticResource SettingsDescriptionStyle}" />
                                        <TextBlock Grid.Row="0" Grid.Column="3" x:Name="BatteryCyclesText"
                                                   Text="—" TextWrapping="Wrap" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="满充容量"
                                                   Style="{StaticResource SettingsDescriptionStyle}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                                   x:Name="BatteryCapacityText"
                                                   Text="—" TextWrapping="Wrap" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="化学类型"
                                                   Style="{StaticResource SettingsDescriptionStyle}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="BatteryChemistryText"
                                                   Text="—" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="制造商"
                                                   Style="{StaticResource SettingsDescriptionStyle}" />
                                        <TextBlock Grid.Row="2" Grid.Column="3" x:Name="BatteryVendorText"
                                                   Text="—" TextWrapping="Wrap" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="型号"
                                                   Style="{StaticResource SettingsDescriptionStyle}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="BatteryModelText"
                                                   Text="—" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="序列号"
                                                   Style="{StaticResource SettingsDescriptionStyle}" />
                                        <TextBlock Grid.Row="3" Grid.Column="3" x:Name="BatterySerialText"
                                                   Text="—" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- ── 屏幕页 ── -->
                <ScrollViewer
                    x:Name="ScreenPage"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="ScreenLayoutGrid"
                          Padding="24,8,24,24"
                          ColumnSpacing="20"
                          RowSpacing="24"
                          SizeChanged="ScreenLayoutGridSizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ScreenCol0" Width="6*" />
                            <ColumnDefinition x:Name="ScreenCol1" Width="5*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="20">
                            <StackPanel Spacing="4">
                                <TextBlock Text="显示" Style="{StaticResource SettingsGroupHeaderStyle}" />
                                <Border Style="{StaticResource SettingsCompoundCardStyle}">
                                    <StackPanel>
                                        <Border Style="{StaticResource SettingsCompoundRowStyle}">
                                            <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="&#xE7F4;" Style="{StaticResource SettingsRowIconStyle}" />
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="刷新率" TextWrapping="Wrap" />
                                                    <TextBlock
                                                        x:Name="ScreenRefreshStatusText"
                                                        Text="较高刷新率使手写与滚动更顺滑，60 Hz 可降低屏幕功耗。"
                                                        Style="{StaticResource SettingsDescriptionStyle}" />
                                                </StackPanel>
                                                <ComboBox
                                                    x:Name="ScreenRefreshCombo"
                                                    Grid.Column="2"
                                                    MinWidth="140"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="刷新率"
                                                    SelectionChanged="ScreenRefreshSelectionChanged" />
                                            </Grid>
                                        </Border>
                                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                        <Border Style="{StaticResource SettingsCompoundRowStyle}">
                                            <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="&#xE740;" Style="{StaticResource SettingsRowIconStyle}" />
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="显示规格" TextWrapping="Wrap" />
                                                    <TextBlock
                                                        x:Name="ScreenModeSpecText"
                                                        Text="正在读取当前显示模式…"
                                                        Style="{StaticResource SettingsDescriptionStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="色彩与护眼" Style="{StaticResource SettingsGroupHeaderStyle}" />
                                <Border Style="{StaticResource SettingsCompoundCardStyle}">
                                    <StackPanel>
                                        <Border Style="{StaticResource SettingsCompoundRowStyle}">
                                            <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="&#xE790;" Style="{StaticResource SettingsRowIconStyle}" />
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="色域" TextWrapping="Wrap" />
                                                    <TextBlock
                                                        x:Name="ColorModeStatusText"
                                                        Text="套用屏幕的出厂色彩校准，仅对内置屏幕生效。"
                                                        Style="{StaticResource SettingsDescriptionStyle}" />
                                                </StackPanel>
                                                <ComboBox
                                                    x:Name="ColorModeCombo"
                                                    Grid.Column="2"
                                                    MinWidth="140"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="色域"
                                                    SelectionChanged="ColorModeChanged">
                                                    <ComboBoxItem Content="Native" />
                                                    <ComboBoxItem Content="sRGB" />
                                                    <ComboBoxItem Content="Display P3" />
                                                </ComboBox>
                                            </Grid>
                                        </Border>

                                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                        <Border Style="{StaticResource SettingsCompoundRowStyle}">
                                            <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="&#xE7B3;" Style="{StaticResource SettingsRowIconStyle}" />
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="护眼模式" TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Text="减弱蓝光。此模式下屏幕偏黄为正常现象。"
                                                        Style="{StaticResource SettingsDescriptionStyle}" />
                                                </StackPanel>
                                                <ToggleSwitch
                                                    x:Name="EyeComfortToggle"
                                                    Grid.Column="2"
                                                    MinWidth="0"
                                                    OnContent=""
                                                    OffContent=""
                                                    Margin="0,0,-12,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="护眼模式"
                                                    Toggled="EyeComfortToggled" />
                                            </Grid>
                                        </Border>

                                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                        <Border Style="{StaticResource SettingsCompoundRowStyle}">
                                            <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="&#xE793;" Style="{StaticResource SettingsRowIconStyle}" />
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="色温" TextWrapping="Wrap" />
                                                    <TextBlock
                                                        x:Name="ColorTemperatureStatusText"
                                                        Text="调节屏幕的冷暖。数值越低画面越暖。"
                                                        Style="{StaticResource SettingsDescriptionStyle}" />
                                                </StackPanel>
                                                <ToggleSwitch
                                                    x:Name="ColorTemperatureToggle"
                                                    Grid.Column="2"
                                                    MinWidth="0"
                                                    OnContent=""
                                                    OffContent=""
                                                    Margin="0,0,-12,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="色温开关"
                                                    Toggled="ColorTemperatureToggled" />
                                            </Grid>
                                        </Border>

                                        <StackPanel x:Name="ColorTemperatureSliderRow" Visibility="Collapsed">
                                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                            <Border Padding="16,12,16,14">
                                                <StackPanel Spacing="10">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="快捷预设"
                                                                   Style="{StaticResource SettingsDescriptionStyle}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,4,0" />
                                                        <Button x:Name="ColorTempWarmPresetBtn"
                                                                Content="暖色 4000K"
                                                                Tag="4000"
                                                                Padding="10,4"
                                                                Click="ColorTemperaturePresetClicked" />
                                                        <Button x:Name="ColorTempStandardPresetBtn"
                                                                Content="标准 6500K"
                                                                Tag="6500"
                                                                Padding="10,4"
                                                                Click="ColorTemperaturePresetClicked" />
                                                        <Button x:Name="ColorTempCoolPresetBtn"
                                                                Content="冷色 8000K"
                                                                Tag="8000"
                                                                Padding="10,4"
                                                                Click="ColorTemperaturePresetClicked" />
                                                    </StackPanel>
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" MinWidth="28" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" MinWidth="56" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="暖" VerticalAlignment="Center"
                                                                   Style="{StaticResource SettingsDescriptionStyle}" />
                                                        <Slider
                                                            x:Name="ColorTemperatureSlider"
                                                            Grid.Column="1"
                                                            Minimum="2000"
                                                            Maximum="10000"
                                                            StepFrequency="500"
                                                            TickFrequency="2000"
                                                            TickPlacement="Outside"
                                                            VerticalAlignment="Center"
                                                            AutomationProperties.Name="色温数值"
                                                            ValueChanged="ColorTemperatureChanged" />
                                                        <TextBlock
                                                            x:Name="ColorTemperatureValueText"
                                                            Grid.Column="2"
                                                            Text="关闭"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Right" />
                                                        <Button
                                                            x:Name="ColorTemperatureResetButton"
                                                            Grid.Column="3"
                                                            Padding="8"
                                                            MinWidth="34"
                                                            MinHeight="34"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            VerticalAlignment="Center"
                                                            AutomationProperties.Name="重置色温为 6500K"
                                                            ToolTipService.ToolTip="重置为 6500K"
                                                            Click="ColorTemperatureResetClicked">
                                                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                                        </Button>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <!-- 自然色彩这一项不在界面上出现：tcs3701 ALS 驱动限制说明保留。 -->
                        </StackPanel>

                        <!-- 色彩对照卡片：宽屏时与左侧设置并排展示，消除下方大块空白 -->
                        <StackPanel x:Name="ScreenPreviewPanel" Grid.Row="0" Grid.Column="1" Spacing="4">
                            <TextBlock Text="色彩与灰阶对照" Style="{StaticResource SettingsGroupHeaderStyle}" />
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <Border CornerRadius="4">
                                        <Border.Clip>
                                            <RectangleGeometry x:Name="ColorReferenceClip" />
                                        </Border.Clip>
                                        <Image
                                            x:Name="ColorReferenceImage"
                                            Height="210"
                                            Stretch="UniformToFill"
                                            SizeChanged="ColorReferenceSizeChanged" />
                                    </Border>
                                    <Grid Height="24" ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="4" Background="#FFFFFF" />
                                        <Border Grid.Column="1" CornerRadius="4" Background="#C8C8C8" />
                                        <Border Grid.Column="2" CornerRadius="4" Background="#969696" />
                                        <Border Grid.Column="3" CornerRadius="4" Background="#646464" />
                                        <Border Grid.Column="4" CornerRadius="4" Background="#323232" />
                                        <Border Grid.Column="5" CornerRadius="4" Background="#000000" />
                                    </Grid>
                                    <Border Height="1" Margin="0,2,0,0"
                                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Grid ColumnSpacing="16" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="64" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" MinWidth="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="当前色域"
                                                   Style="{StaticResource SettingsDescriptionStyle}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ScreenSummaryGamutText"
                                                   Text="Native" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="色温白点"
                                                   Style="{StaticResource SettingsDescriptionStyle}" />
                                        <TextBlock Grid.Row="0" Grid.Column="3" x:Name="ScreenSummaryTempText"
                                                   Text="关闭" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="护眼过滤"
                                                   Style="{StaticResource SettingsDescriptionStyle}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ScreenSummaryEyeText"
                                                   Text="关闭" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="刷新率"
                                                   Style="{StaticResource SettingsDescriptionStyle}" />
                                        <TextBlock Grid.Row="1" Grid.Column="3" x:Name="ScreenSummaryRefreshText"
                                                   Text="—" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- ── 服务页 ── -->
                <ScrollViewer
                    x:Name="GeneralPage"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Padding="24,8,24,24" Spacing="24">
                        <!-- 每个 ToggleSwitch 上的 MinWidth / OnContent / OffContent / Margin 是一组，
                             用来让开关本体贴住卡片右缘，与 ComboBox 和按钮的右缘对齐：
                             默认 MinWidth 154 里只有左边约 40 是开关本体，其余是给 On/Off 文字预留的，
                             清掉文字那段宽度也不会收回；模板中开关与文字之间还有一个写死 12 的列，文字
                             为空后它就是纯粹的尾部留白，只能用负边距抵掉。
                             这几个值必须写在控件上。同样的设置放进 Style 的 Setter 里，MinWidth 不会生效，
                             实测开关仍按 154 排布。 -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="接管与兼容" Style="{StaticResource SettingsGroupHeaderStyle}" />
                            <Border Style="{StaticResource SettingsCompoundCardStyle}">
                                <StackPanel>
                                    <Border Style="{StaticResource SettingsCompoundRowStyle}">
                                        <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xEDA4;" Style="{StaticResource SettingsRowIconStyle}" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="接管触控与手写笔" TextWrapping="Wrap" />
                                                <TextBlock
                                                    x:Name="TouchProviderStatusText"
                                                    Text="正在检查…"
                                                    Style="{StaticResource SettingsDescriptionStyle}" />
                                            </StackPanel>
                                            <ProgressRing
                                                x:Name="TouchProviderProgress"
                                                Grid.Column="2"
