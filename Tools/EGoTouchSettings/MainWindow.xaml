<Window
    x:Class="EGoTouchSettings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EGoTouchSettings"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootLayout" Background="Transparent">
        <!-- Window 没有 Resources 属性，页面级样式只能挂在根 Grid 上。 -->
        <Grid.Resources>
            <Style x:Key="SettingsCardStyle" TargetType="Border">
                <Setter Property="MinHeight" Value="72" />
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="SettingsCompoundCardStyle" TargetType="Border">
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="SettingsCompoundRowStyle" TargetType="Border">
                <Setter Property="MinHeight" Value="68" />
                <Setter Property="Padding" Value="16,14" />
            </Style>

            <Style x:Key="HomeNavCardButtonStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="MinHeight" Value="72" />
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <!-- 只有一两行文字、没有右侧控件的卡片。SettingsCardStyle 的 MinHeight 是给
                 「图标 + 标题 + 描述 + 控件」那种行准备的，用在纯文本上会在下方空出半张
                 卡片，字还小，看起来像没加载完。 -->
            <Style x:Key="SettingsCardCompactStyle" TargetType="Border"
                   BasedOn="{StaticResource SettingsCardStyle}">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="16,12" />
            </Style>

            <Style x:Key="SettingsGroupHeaderStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="4,0,0,4" />
            </Style>

            <!-- 带图标的分组标题，用在成段的规格列表上（设备页与电池页）。图标本身不表达
                 新信息，作用是让几段并列的规格在扫读时有落点——纯文字标题连着几张卡片，
                 视线找不到分界。
                 这两个样式配合 GroupHeaderRowStyle 使用，三者要一起改。 -->
            <Style x:Key="SpecGroupIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="SpecGroupTitleStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="GroupHeaderRowStyle" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal" />
                <Setter Property="Spacing" Value="8" />
                <Setter Property="Margin" Value="4,0,0,4" />
            </Style>

            <Style x:Key="SettingsDescriptionStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SettingsRowIconStyle" TargetType="FontIcon">
                <Setter Property="Width" Value="24" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 设备页的一行属性：左标签右取值，取值缺失时整行由代码隐藏。 -->
            <Style x:Key="DeviceFieldLabelStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="DeviceFieldValueStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            Title="OpenEGo Hub">
            <!-- 图标在代码里设，见 SetTitleBarIconAsync：图片嵌在 exe 的 RCDATA 里，
                 XAML 这边没法直接引。
                 不要改用 PathIconSource——那会让窗口一显示就抛 0xC000027B，是
                 microsoft-ui-xaml#9784，内联几何和资源查找都一样。 -->
        </TitleBar>

        <!-- 七页共用一个 NavigationView，内容用 Visibility 切换而不是 Frame 导航：
             Frame 要求每页各自是一个 WinRT 类型，得为每一页加 .idl 条目和生成代码，而页面之间
             要共享的状态（托盘连接、服务是否就绪）又都挂在这个窗口上，拆成独立类型之后还得
             再把它们传回去。页数变多也没有改变这笔账。 -->
        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Auto"
            ExpandedModeThresholdWidth="640"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            OpenPaneLength="180"
            SelectionChanged="NavSelectionChanged"
            ItemInvoked="NavItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavHome" Content="概览" Tag="home" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavDevices" Content="配件" Tag="devices">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE772;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavBattery" Content="电池" Tag="battery">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEBAA;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavScreen" Content="屏幕" Tag="screen">
                    <NavigationViewItem.Icon>
                        <!-- 这一页调的是色温、护眼和色域，用亮度而不是显示器：本机是一块
                             平板，画一台带底座的显示器指的是别的东西。 -->
                        <FontIcon Glyph="&#xE706;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavGeneral" Content="服务" Tag="general">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9F5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavDevice" Content="设备" Tag="device">
                    <NavigationViewItem.Icon>
                        <!-- 这一页列的是处理器、内存这些本机规格，不是「另一台设备」。 -->
                        <FontIcon Glyph="&#xE950;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <!-- 外观只有三个互斥选项，撑不起一页，也不该塞进哪一页的末尾——它管的是整个
                     窗口，不属于配件或屏幕。放在导航栏底部、关于之上，用 flyout 就地选，
                     SelectsOnInvoked="False" 让它不参与选页。 -->
                <NavigationViewItem x:Name="NavTheme" Content="外观" Tag="theme"
                                    SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                    <FlyoutBase.AttachedFlyout>
                        <MenuFlyout Placement="Right">
                            <RadioMenuFlyoutItem x:Name="ThemeSystemItem" Text="跟随系统"
                                                 GroupName="AppTheme" Tag="system"
                                                 Click="ThemeSelected" />
                            <RadioMenuFlyoutItem x:Name="ThemeLightItem" Text="浅色"
                                                 GroupName="AppTheme" Tag="light"
                                                 Click="ThemeSelected" />
                            <RadioMenuFlyoutItem x:Name="ThemeDarkItem" Text="深色"
                                                 GroupName="AppTheme" Tag="dark"
                                                 Click="ThemeSelected" />
                        </MenuFlyout>
                    </FlyoutBase.AttachedFlyout>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavAbout" Content="关于" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- 内容铺满可用宽度，与 Windows 设置一致。不要加 MaxWidth：加了之后要么右侧空出
                 一大片，要么得配 HorizontalAlignment 才能定位，而 Stretch 配 MaxWidth 的落位
                 本身没有定论（实测最大化后内容整体贴到右侧）。铺满是唯一不需要额外约定的写法。 -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    x:Name="PageHeaderText"
                    Grid.Row="0"
                    Text="概览"
                    Margin="24,12,24,8"
                    Style="{StaticResource TitleTextBlockStyle}" />

                <!-- InfoBar 播报的是整个程序范围的状态（托盘未运行、切换失败、正在退出），
                     并且会决定设置页控件是否可用。放在滚动区之外、导航内容区之上，
                     换页和滚动都不会让它消失。 -->
                <StackPanel Grid.Row="1" Spacing="4">
                    <InfoBar
                        x:Name="StatusInfoBar"
                        Margin="24,0,24,0"
                        IsOpen="False"
                        IsClosable="False"
                        Severity="Informational" />
                    <!-- 华为服务还开着时的提醒。跨页面常驻，因为这件事与用户当前在看哪一页
                         无关；关掉一次就永久不再出现——他已经表达了「我不想禁用」，反复问
                         是骚扰。 -->
                    <InfoBar
                        x:Name="VendorHintBar"
                        Margin="24,0,24,4"
                        IsOpen="False"
                        IsClosable="True"
                        Severity="Informational"
                        Title="华为后台服务仍在运行"
                        Message="触控、手写笔、键盘与充电控制已由本程序接管，这些服务可以停用。"
                        CloseButtonClick="VendorHintDismissed">
                        <InfoBar.ActionButton>
                            <Button Content="去处理" Click="VendorHintActionClicked" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </StackPanel>

                <Grid x:Name="PageHost" Grid.Row="2">

                <!-- ── 概览页 ── -->
                <ScrollViewer
                    x:Name="HomePage"
                    Visibility="Visible"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Padding="24,8,24,24" Spacing="24">
                        <!-- 主机 Hero 卡片：产品图 + 处理器 + 硬件摘要 + 本机规格入口 -->
                        <Border Style="{StaticResource SettingsCardStyle}" Padding="24,20">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="124" Height="80" VerticalAlignment="Center">
                                    <Image
                                        x:Name="HomeMachineImage"
                                        Width="124"
                                        Height="80"
                                        Stretch="Uniform"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed" />
                                    <FontIcon
                                        x:Name="HomeMachineFallback"
                                        Glyph="&#xE70A;"
                                        FontSize="36"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="HomeMachineNameText"
                                        Text="HUAWEI MateBook E Go"
                                        Style="{StaticResource TitleTextBlockStyle}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="HomeMachineSubText"
                                        Style="{StaticResource SettingsDescriptionStyle}"
                                        TextWrapping="Wrap" />
                                    <StackPanel x:Name="HomeMachineSpecsRow"
                                                Orientation="Horizontal"
                                                Spacing="20"
                                                Margin="0,2,0,0">
                                        <StackPanel x:Name="HomeSpecMemoryItem"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    Visibility="Collapsed">
                                            <FontIcon Glyph="&#xE950;" FontSize="12"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      VerticalAlignment="Center" />
                                            <TextBlock x:Name="HomeSpecMemoryText"
                                                       Style="{StaticResource SettingsDescriptionStyle}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel x:Name="HomeSpecDisplayItem"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    Visibility="Collapsed">
                                            <FontIcon Glyph="&#xE7F4;" FontSize="12"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      VerticalAlignment="Center" />
                                            <TextBlock x:Name="HomeSpecDisplayText"
                                                       Style="{StaticResource SettingsDescriptionStyle}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel x:Name="HomeSpecModelItem"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    Visibility="Collapsed">
                                            <FontIcon Glyph="&#xE946;" FontSize="12"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      VerticalAlignment="Center" />
                                            <TextBlock x:Name="HomeSpecModelText"
                                                       Style="{StaticResource SettingsDescriptionStyle}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Tag="device"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="硬件规格"
                                        Click="HomeNavCardClicked">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="硬件规格" VerticalAlignment="Center" />
                                        <FontIcon Glyph="&#xE76C;"
                                                  FontSize="11"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- 状态概览：等高三列遥测卡片，窄屏自动纵向堆叠 -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="状态概览" Style="{StaticResource SettingsGroupHeaderStyle}" />
                            <Grid x:Name="HomeStatusGrid"
                                  ColumnSpacing="12"
                                  RowSpacing="12"
                                  SizeChanged="HomeStatusGridSizeChanged">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="HomeStatusCol0" Width="*" />
                                    <ColumnDefinition x:Name="HomeStatusCol1" Width="*" />
                                    <ColumnDefinition x:Name="HomeStatusCol2" Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Button x:Name="HomePowerCard"
                                        Style="{StaticResource HomeNavCardButtonStyle}"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Tag="battery"
                                        MinHeight="108"
                                        VerticalAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        AutomationProperties.Name="本机电源"
                                        Click="HomeNavCardClicked">
                                    <Grid RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid ColumnSpacing="8" MinHeight="28">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <local:BatteryIndicator x:Name="HomeHostBatteryIcon"
                                                                        VerticalAlignment="Center" />
                                                <TextBlock Text="本机电源"
                                                           Style="{StaticResource SettingsDescriptionStyle}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock x:Name="HomeBatteryPercentText"
                                                       Grid.Column="1"
                                                       Text="—"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                        <StackPanel Grid.Row="1" Spacing="6" VerticalAlignment="Bottom">
                                            <ProgressBar x:Name="HomeBatteryBar"
                                                         Minimum="0"
                                                         Maximum="100"
                                                         Value="0" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="HomeBatteryStateText"
                                                           Text="正在读取"
                                                           Style="{StaticResource SettingsDescriptionStyle}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="HomeBatteryLimitText"
                                                           Grid.Column="1"
                                                           Style="{StaticResource SettingsDescriptionStyle}"
                                                           HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <Button x:Name="HomePenCard"
                                        Style="{StaticResource HomeNavCardButtonStyle}"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Tag="devices"
                                        MinHeight="108"
                                        VerticalAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        AutomationProperties.Name="手写笔"
                                        Click="HomeNavCardClicked">
                                    <Grid RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid ColumnSpacing="8" MinHeight="28">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE70F;"
                                                          FontSize="16"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Text="手写笔"
                                                           Style="{StaticResource SettingsDescriptionStyle}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <local:BatteryIndicator x:Name="HomePenBattery"
                                                                    Grid.Column="1"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center" />
                                        </Grid>
                                        <StackPanel Grid.Row="1" Spacing="2" VerticalAlignment="Bottom">
                                            <TextBlock x:Name="HomePenNameText"
                                                       Text="HUAWEI M-Pencil"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="HomePenStateText"
                                                       Text="未连接"
                                                       Style="{StaticResource SettingsDescriptionStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <Button x:Name="HomeKeyboardCard"
                                        Style="{StaticResource HomeNavCardButtonStyle}"
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Tag="devices"
                                        MinHeight="108"
                                        VerticalAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        AutomationProperties.Name="磁吸键盘"
                                        Click="HomeNavCardClicked">
                                    <Grid RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid ColumnSpacing="8" MinHeight="28">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE765;"
                                                          FontSize="16"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Text="磁吸键盘"
                                                           Style="{StaticResource SettingsDescriptionStyle}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <local:BatteryIndicator x:Name="HomeKeyboardBattery"
                                                                    Grid.Column="1"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center" />
                                        </Grid>
                                        <StackPanel Grid.Row="1" Spacing="2" VerticalAlignment="Bottom">
                                            <TextBlock x:Name="HomeKeyboardNameText"
                                                       Text="HUAWEI 智能磁吸键盘"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="HomeKeyboardStateText"
                                                       Text="未连接"
                                                       Style="{StaticResource SettingsDescriptionStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- 常用设置：在首页直接调节最常改的四项控制，状态与各分页严格同步 -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="常用设置" Style="{StaticResource SettingsGroupHeaderStyle}" />
                            <Border Style="{StaticResource SettingsCompoundCardStyle}">
                                <StackPanel>
                                    <Border Style="{StaticResource SettingsCompoundRowStyle}">
                                        <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xEDA4;" Style="{StaticResource SettingsRowIconStyle}" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="接管触控与手写笔" TextWrapping="Wrap" />
                                                <TextBlock x:Name="HomeTouchStatusText"
                                                           Text="正在检查…"
                                                           Style="{StaticResource SettingsDescriptionStyle}" />
                                            </StackPanel>
                                            <ProgressRing x:Name="HomeTouchProgress"
                                                          Grid.Column="2"
                                                          Width="16"
                                                          Height="16"
                                                          IsActive="False"
                                                          Visibility="Collapsed"
                                                          VerticalAlignment="Center" />
                                            <Button Grid.Column="3"
                                                    Content="服务管理"
                                                    Tag="general"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="服务管理"
                                                    Click="HomeNavCardClicked" />
                                            <ToggleSwitch x:Name="HomeTouchToggle"
                                                          Grid.Column="4"
                                                          MinWidth="0"
                                                          OnContent=""
                                                          OffContent=""
                                                          Margin="0,0,-12,0"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          AutomationProperties.Name="接管触控与手写笔"
                                                          Toggled="TouchProviderToggled" />
                                        </Grid>
                                    </Border>

                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                    <Border Style="{StaticResource SettingsCompoundRowStyle}">
                                        <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE70F;" Style="{StaticResource SettingsRowIconStyle}" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="手写笔双击行为" TextWrapping="Wrap" />
                                                <TextBlock Text="选择连按两次笔侧键时执行的操作。"
                                                           Style="{StaticResource SettingsDescriptionStyle}" />
                                            </StackPanel>
                                            <ComboBox x:Name="HomePenModeSelector"
