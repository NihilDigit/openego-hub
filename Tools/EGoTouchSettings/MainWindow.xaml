                                    </Border>

                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                    <Border Style="{StaticResource SettingsCompoundRowStyle}">
                                        <Grid ColumnSpacing="16" VerticalAlignment="Center">
