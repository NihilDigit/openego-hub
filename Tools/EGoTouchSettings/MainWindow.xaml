                                            </Grid>
                                        </Border>

                                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                        <Border Style="{StaticResource SettingsCompoundRowStyle}">
                                            <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="&#xE8A5;" Style="{StaticResource SettingsRowIconStyle}" />
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="开源许可" TextWrapping="Wrap" />
