                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                            <ToggleSwitch
                                                x:Name="VendorServicesToggle"
                                                Grid.Column="3"
                                                MinWidth="0"
                                                OnContent=""
                                                OffContent=""
                                                Margin="0,0,-12,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="禁用华为后台服务"
