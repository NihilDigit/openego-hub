                                                </Viewbox>
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="开源仓库" TextWrapping="Wrap" />
                                                    <TextBlock Text="查看源代码、版本发布与问题反馈。"
