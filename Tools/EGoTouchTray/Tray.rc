// 托盘进程的可执行文件图标。托盘图标本身是按 DPI 与任务栏明暗现画的（见
// CreateBrandIcon），这里这张管的是别处：开始菜单快捷方式、Alt+Tab、任务管理器。
// 此前托盘没有任何图标资源，那几处显示的是 Windows 的通用可执行文件图标。
//
// 与设置窗口共用同一份 .ico，由 scripts/make_brand_assets.py 从品牌 SVG 生成。

#include <windows.h>

#include "AppIconResource.h"
#include "AppVersion.h"

IDI_APP_ICON ICON "..\\EGoTouchSettings\\Assets\\OpenEGoHub.ico"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    OPENEGO_VERSION_MAJOR, OPENEGO_VERSION_MINOR, OPENEGO_VERSION_PATCH, 0
    PRODUCTVERSION OPENEGO_VERSION_MAJOR, OPENEGO_VERSION_MINOR, OPENEGO_VERSION_PATCH, 0
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
    FILEFLAGS      0x0L
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_APP
    FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "OpenEGo Hub"
            VALUE "FileDescription",  "OpenEGo Hub 托盘"
            VALUE "FileVersion",      OPENEGO_VERSION_STRING
            VALUE "InternalName",     "OpenEGoHubTray"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "OpenEGoHubTray.exe"
            VALUE "ProductName",      "OpenEGo Hub"
            VALUE "ProductVersion",   OPENEGO_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
