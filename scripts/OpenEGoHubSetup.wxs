<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <?ifndef BuildOutputDir ?>
    <?define BuildOutputDir = "build" ?>
  <?endif ?>
  <!-- hal 不经主 CMake 构建，产物落在自己的目录里，与 BuildOutputDir 无关。 -->
  <?ifndef HalOutputDir ?>
    <?define HalOutputDir = "hal\build\Release" ?>
  <?endif ?>
  <!--
    OpenEGo Hub 核心服务安装包
    - -arch arm64 由命令行参数设定原生架构。

    UpgradeCode 决定哪些已装产品算「同一条产品线」，本该一次定死。实际上它换过一次：
    产品由 EGoTouchRev 改名为 OpenEGo Hub 时换成了下面这个 67A4C6B5，改名之前发出去的
    包因此完全落在当前升级路径之外。历史上用过的三条谱系：

      434AC770-…-DB2F9DB289AC  改名前的预发布包
      434AC770-…-DB2F9DB289AD  同期的 Test 版
      F7F7E243-…               v0.1.x Test 包，与正式包共用服务名和安装目录

    MajorUpgrade 只看当前 UpgradeCode，这三条它一条都看不见，装新包时旧包原样留着；
    F7F7E243 那条还会和新包抢同一个 OpenEGoHubService 和 Program Files 目录。下面三行
    手写的 Upgrade 把它们纳入 RemoveExistingProducts 的视野，让旧包各自走自己的卸载序列。
  -->
  <Package Name="!(loc.ProductName)" Manufacturer="!(loc.Manufacturer)" Version="$(var.BuildVersion)"
           UpgradeCode="67A4C6B5-BFFB-4058-9600-1109A3B59A03"
           Scope="perMachine"
           Language="!(loc.Language)">

    <!--
      支持自动覆盖升级：UpgradeCode 不变 + Version 提升 → 自动卸载旧版覆盖安装。
      AllowSameVersionUpgrades 让版本号相同的包也走升级而不是并存装两份；ProductCode 取
      WiX 默认的 *，每次构建都是新的，前提成立。

      Schedule 保持默认的 afterInstallValidate，即在装新文件之前就把旧产品整个卸干净。旧包
      的服务由它自己的 ServiceControl 停掉和删除，这是最正规的一条路；F7F7E243 那条谱系与
      新包同服务名同目录，先卸后装才不会出现两个包争一个服务的局面。挪到 afterInstallExecute
      会让两份文件在盘上重叠一段时间，正是要避开的。
    -->
    <MajorUpgrade DowngradeErrorMessage="!(loc.DowngradeError)"
                  AllowSameVersionUpgrades="yes" />

    <!-- 改名前的预发布包 -->
    <Upgrade Id="434AC770-0762-431A-9ABC-DB2F9DB289AC">
      <UpgradeVersion Property="LEGACY_PRERELEASE_DETECTED"
                      Minimum="0.0.0" IncludeMinimum="yes"
                      Maximum="255.255.65535" IncludeMaximum="yes"
                      MigrateFeatures="no" OnlyDetect="no" />
    </Upgrade>

    <!-- 同期的 Test 版 -->
    <Upgrade Id="434AC770-0762-431A-9ABC-DB2F9DB289AD">
      <UpgradeVersion Property="LEGACY_PRERELEASE_TEST_DETECTED"
                      Minimum="0.0.0" IncludeMinimum="yes"
                      Maximum="255.255.65535" IncludeMaximum="yes"
                      MigrateFeatures="no" OnlyDetect="no" />
    </Upgrade>

    <!-- v0.1.x Test 包，与正式包共用服务名和安装目录 -->
    <Upgrade Id="F7F7E243-B91A-4B0A-9B16-FF7DD30E62A0">
      <UpgradeVersion Property="LEGACY_TESTPKG_DETECTED"
                      Minimum="0.0.0" IncludeMinimum="yes"
                      Maximum="255.255.65535" IncludeMaximum="yes"
                      MigrateFeatures="no" OnlyDetect="no" />
    </Upgrade>

    <!-- 安装向导界面：WixUI_InstallDir 提供欢迎页 + 许可协议 + 安装目录 + 进度 + 完成 -->
    <ui:WixUI Id="WixUI_InstallDir" />

    <!-- 必须指定 WixUI_InstallDir 绑定的安装目录属性，否则运行时会报 Error 2819 -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!--
      完成页勾选「启动 OpenEGo Hub」，默认勾上。托盘的登录自启只写 HKCU Run 键，要到下次
      登录才生效；没有这一步，首装之后什么都不出现，升级之后旧托盘被 Restart Manager 关掉
      也没人拉回来（托盘 0.2.1 起自己注册 RegisterApplicationRestart，但从更老版本升上来时
      被关掉的是没注册过的旧托盘）。

      WixShellExec 跑在 UI 序列的客户端进程里。标准的双击安装流程中客户端不提权，托盘因此
      以普通完整性启动，符合它必须无提权运行的约束；从已提权的终端里 msiexec 装包则客户端
      本身就是提权的，托盘会跟着提权——那是开发场景，装完手动重启托盘即可。静默安装没有
      UI 序列，此路径不生效，维持原有行为。

      托盘已在运行时再启动一次不会出第二个实例：新进程发现互斥量已存在，向主实例投递激活
      消息打开设置窗后退出。
    -->
    <!--
      在执行序列里直接关托盘,不依赖 Restart Manager:basic UI 的卸载(设置里点卸载就是)
      没有 FilesInUse 对话框,没人替 RM 点「同意关闭」,托盘会被原样留下,变成镜像文件已
      删的孤儿进程。WM_CLOSE 对托盘是干净退出路径(DefWindowProc → DestroyWindow),实测
      验证过。升级时它排在 RemoveExistingProducts 之后,旧包卸载阶段帮不上忙,全 UI 升级
      仍靠 RM 的交互式关闭;它兜底的是卸载和静默场景。
    -->
    <util:CloseApplication Id="CloseTrayApp" Target="OpenEGoHubTray.exe"
                           CloseMessage="yes" RebootPrompt="no" />

    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="!(loc.LaunchTrayCheckbox)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#EGoTouchTrayEXE]" />
    <CustomAction Id="LaunchTray" DllEntry="WixShellExec" Impersonate="yes"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" />

    <!--
      卸载时把华为的登录自启项还回去。禁用状态记在 HKCU，而卸载序列以系统身份执行，读到的
      是 SYSTEM 自己的 hive——服务那侧的 RestoreAll 只够还原 HKLM 的服务，这一半够不着。
      Impersonate="yes" 让它落在触发卸载的那个用户上下文里，也就是当初禁用它们的那个人。

      同步执行而不是 ShellExec：托盘的 exe 马上就要被 RemoveFiles 删掉，异步启动会跑输删除。
      Return="ignore" 是因为恢复失败不该拦住卸载——留下几条自启项，比留下一个装了一半的
      系统好得多。
    -->
    <CustomAction Id="RestoreVendorAutorun" FileRef="EGoTouchTrayEXE"
                  ExeCommand="--restore-vendor-autorun"
                  Execute="immediate" Impersonate="yes" Return="ignore" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchTray"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

    <!-- 让 Windows Installer 自动写 %TEMP%\MSI*.LOG。服务自己的日志覆盖不到安装器这半：
         装到哪一步、StartServices 等了多久，只有 MSI 日志里有。voicewarmup 是除 x（调试
         额外输出）外的全部开关。 -->
    <Property Id="MsiLogging" Value="voicewarmup" />

    <!-- 许可协议 RTF -->
    <WixVariable Id="WixUILicenseRtf" Value="!(loc.LicenseRtf)" />

    <!-- 安装目录页：用户可自定义安装路径，默认 C:\Program Files\OpenEGoHub -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="OpenEGoHub">
        <Directory Id="CONFIGFOLDER" Name="config" />
      </Directory>
    </StandardDirectory>

    <!-- 开始菜单入口。装完之后没有任何可点的地方，托盘只在登录后自动启动那一次出现；用户
         手动退出过托盘，就再也没有办法把它请回来。 -->
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- 通过 CAB 将所有文件打包进单个 MSI -->
    <MediaTemplate EmbedCab="yes" />

    <!-- 核心组件 -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">

      <Component Id="EGoTouchServiceComp" Guid="9C15D5C4-CB7F-45F3-ABE7-CF444306F637">
        <File Id="EGoTouchServiceEXE" Source="$(var.BuildOutputDir)\OpenEGoHubService.exe" KeyPath="yes" />

        <!-- 由 Windows Installer 原生注册系统服务 -->
        <ServiceInstall
            Id="EGoTouchServiceInstaller"
            Type="ownProcess"
            Name="OpenEGoHubService"
            DisplayName="!(loc.ServiceDisplayName)"
            Description="!(loc.ServiceDescription)"
            Start="auto"
            Account="LocalSystem"
            ErrorControl="normal">

          <!--
            SCM 层的失败重启。装完之后华为 PC Manager 的自我修复会让服务状态抖上一阵，启动
            路径在那期间判失败就整个装完却没有服务在跑，这一条是最迟 45 秒自愈的兜底下限。
            util 扩展只能给一个统一的延迟，做不出 5/10/30 秒的分级；服务代码里的分级恢复
            策略随后会把这份配置覆盖掉，这里保证的是「装出来就有」。
          -->
          <util:ServiceConfig
              FirstFailureActionType="restart"
              SecondFailureActionType="restart"
              ThirdFailureActionType="restart"
              RestartServiceDelayInSeconds="5"
              ResetPeriodInDays="1" />
        </ServiceInstall>

        <!-- 控制在安装/卸载时自动启停服务 -->
        <ServiceControl Id="StartWixService" Name="OpenEGoHubService"
                        Start="install"
                        Stop="both"
                        Remove="uninstall" />
      </Component>

      <Component Id="EGoTouchTrayComp" Guid="40FAE0AA-41EB-432C-AF3C-FDD0266BD13F">
        <File Id="EGoTouchTrayEXE" Source="$(var.BuildOutputDir)\OpenEGoHubTray.exe" KeyPath="yes" />

        <!-- 指向托盘而不是设置窗：托盘是常驻进程，设置窗要靠它才能改配置。托盘没在跑时
             这个入口把它拉起来，已经在跑时托盘的第二个实例会转交给在跑的那个去开设置窗。 -->
        <Shortcut Id="EGoTouchStartMenuShortcut"
                  Directory="ProgramMenuFolder"
                  Name="!(loc.ShortcutName)"
                  Description="!(loc.ShortcutDescription)"
                  Target="[INSTALLFOLDER]OpenEGoHubTray.exe"
                  WorkingDirectory="INSTALLFOLDER" />
      </Component>

      <!-- HKCU 数据必须使用独立的 per-user KeyPath，不能与 Program Files 文件混在同一组件。 -->
      <Component Id="EGoTouchTrayAutoStartComp" Guid="677C60B5-ACFD-4D99-85A0-9FC8AC0C1339">
        <!-- 初次安装默认登录后启动；面板随后按当前用户的选择维护同一个 HKCU Run 值。 -->
        <RegistryValue Root="HKCU"
                       Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="OpenEGoHubTray"
                       Type="string"
                       Value="&quot;[INSTALLFOLDER]OpenEGoHubTray.exe&quot;"
                       KeyPath="yes" />
      </Component>

      <Component Id="EGoTouchSettingsComp" Guid="08EB6064-0A8B-4A66-A888-5586CD3460B0">
        <File Id="EGoTouchSettingsEXE" Source="$(var.BuildOutputDir)\OpenEGoHubSettings.exe" KeyPath="yes" />
        <File Id="EGoTouchSettingsPRI" Source="$(var.BuildOutputDir)\OpenEGoHubSettings.pri" />
        <File Id="EGoTouchSettingsWinMD" Source="$(var.BuildOutputDir)\EGoTouchSettings.winmd" />
        <File Id="EGoTouchSettingsAppXBF" Source="$(var.BuildOutputDir)\App.xbf" />
        <File Id="EGoTouchSettingsBatteryIndicatorXBF" Source="$(var.BuildOutputDir)\BatteryIndicator.xbf" />
        <File Id="EGoTouchSettingsMainWindowXBF" Source="$(var.BuildOutputDir)\MainWindow.xbf" />
        <File Id="EGoTouchSettingsNotificationWindowXBF" Source="$(var.BuildOutputDir)\NotificationWindow.xbf" />
        <File Id="WindowsAppRuntimeBootstrapDLL" Source="$(var.BuildOutputDir)\Microsoft.WindowsAppRuntime.Bootstrap.dll" />
      </Component>

      <Component Id="LegalNoticesComp" Guid="FC7B587E-4F03-4730-AFC3-1DE7309F44C8">
        <File Id="ProjectLicense" Source="LICENSE" KeyPath="yes" />
        <File Id="ThirdPartyNotices" Source="THIRD-PARTY-NOTICES.md" />
      </Component>

    </ComponentGroup>

    <!--
      gaokun-hal 的宿主进程。必须与服务同在 INSTALLFOLDER 根下，不能收进子目录：
      ServiceHost 与托盘解析宿主路径时先看自己旁边，找不到才退到 hal 的构建目录，
      而安装位置没有那个相对路径。

      GaokunCtl.exe 是开发用 CLI，不进安装包。
    -->
    <ComponentGroup Id="HalComponents" Directory="INSTALLFOLDER">

      <Component Id="GaokunThpHostComp" Guid="F2B02781-F81C-4A90-9A70-4E2F07585CE7">
        <File Id="GaokunThpHostEXE" Source="$(var.HalOutputDir)\GaokunThpHost.exe" KeyPath="yes" />
      </Component>

      <Component Id="GaokunPenHostComp" Guid="2639816E-2DD8-4FB0-B67F-C1A31DCC0212">
        <File Id="GaokunPenHostEXE" Source="$(var.HalOutputDir)\GaokunPenHost.exe" KeyPath="yes" />
      </Component>

      <Component Id="GaokunKeyboardHostComp" Guid="00AF713A-51EA-4742-B361-D8CB088FEBB9">
        <File Id="GaokunKeyboardHostEXE" Source="$(var.HalOutputDir)\GaokunKeyboardHost.exe" KeyPath="yes" />
      </Component>

      <Component Id="GaokunDisplayComp" Guid="21DE65AF-4F2E-443F-AB6D-6DEDAC96C882">
        <File Id="GaokunDisplayEXE" Source="$(var.HalOutputDir)\GaokunDisplay.exe" KeyPath="yes" />
      </Component>

      <Component Id="GaokunPowerComp" Guid="DAA69D51-7D99-4D95-AF57-93FE7830AFF9">
        <File Id="GaokunPowerEXE" Source="$(var.HalOutputDir)\GaokunPower.exe" KeyPath="yes" />
      </Component>

      <!--
        色域组件。System32 里的同名 DLL 在本机加载得上、符号也解析得到，工厂函数却返回
        null，所以 GaokunDisplay 需要旁边这一份，见 hal/src/display/Qdcm.cpp。

        源取 hal 的输出目录而不是 hal/vendor：hal 的 build.ps1 会把它复制过去，与其余五个
        宿主同源，打包时只认一个目录。
      -->
      <Component Id="QdcmLibComp" Guid="885FD01E-D58A-405C-9AFE-2C0688FDAAFD">
        <File Id="QdcmLibDLL" Source="$(var.HalOutputDir)\qdcmlib.dll" KeyPath="yes" />
      </Component>

    </ComponentGroup>

    <Feature Id="MainFeature" Title="EGoTouch Core" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="HalComponents" />
    </Feature>

    <!--
      清理工具随 MSI 走 Binary 表，不落盘也不进任何组件：它只在安装过程中跑一次，装完
      留在 Program Files 里没有意义。
    -->
    <Binary Id="CleanupExe" SourceFile="$(var.BuildOutputDir)\OpenEGoHubCleanup.exe" />

    <!--
      Upgrade 表管得住的只有 MSI 自己装出来的东西。脚本装的服务、deploy.ps1 留下的
      .backup 目录、改名前的 EGoTouchRev 目录，这些残留没有任何一个包认领，得由这个
      工具扫掉。deferred + Impersonate="no" 才有 LocalSystem 权限动服务和 Program Files；
      Return="ignore" 是因为清残留失败不该让安装失败。
    -->
    <CustomAction Id="CleanSweep" BinaryRef="CleanupExe"
                  ExeCommand=""
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <!--
        位置卡在 RemoveExistingProducts 之后、InstallFiles 之前，两头都不能挪：早于 REP
        会去删旧包还在用的文件，把旧包的卸载序列搅乱；晚于 InstallFiles 则整删目录会连
        刚铺下去的新文件一起删掉。

        锚点不能写 After="RemoveExistingProducts"：MajorUpgrade 默认把 REP 排在
        InstallInitialize 之前，而 deferred 动作必须落在 InstallInitialize 与
        InstallFinalize 的事务之内，排在事务外安装器直接报 2762（实测）。挂在
        InstallInitialize 之后同样满足「REP 之先、InstallFiles 之前」。

        条件 NOT Installed 让它只在首装和升级时跑。卸载和修复不跑——卸载有 ServiceControl
        和组件删除各司其职，修复本就不该动用户环境。回滚也不做补偿：清掉的是历史残留，
        安装失败了它们也不值得还原，这是 clean-install 的语义。
      -->
      <Custom Action="CleanSweep" After="InstallInitialize" Condition="NOT Installed" />

      <!--
        只在卸载时跑，且必须早于 RemoveFiles：它要执行的正是马上要被删掉的那个托盘 exe。
        REMOVE="ALL" 把升级排除在外——升级时 REP 也会走一遍卸载序列，那时把自启项还回去，
        新版本装完就得让用户再禁用一次。
      -->
      <Custom Action="RestoreVendorAutorun" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Package>
</Wix>
