{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "arm64-base",
      "hidden": true,
      "description": "cl.exe is resolved from PATH, so run vcvarsarm64.bat (or use scripts/dev-cycle.ps1) first. CMakeLists enforces an ARM64 target via EGO_REQUIRE_ARM64. Do not add CMAKE_*_COMPILER_TARGET here: it is clang-only and makes CMake emit GNU-style link flags that cl.exe cannot parse.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "architecture": {
        "value": "arm64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": {
          "type": "BOOL",
          "value": "ON"
        },
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": "Windows",
          "intelliSenseMode": "windows-msvc-arm64"
        }
      }
    },
    {
      "name": "arm64-Debug",
      "displayName": "arm64 Debug",
      "inherits": "arm64-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "EGO_BUILD_TOOLS": {
          "type": "BOOL",
          "value": "ON"
        }
      }
    },
    {
      "name": "arm64-Release",
      "displayName": "arm64 Release",
      "inherits": "arm64-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "arm64-Debug",
      "displayName": "arm64 Debug Build",
      "configurePreset": "arm64-Debug"
    },
    {
      "name": "arm64-Release",
      "displayName": "arm64 Release Build",
      "configurePreset": "arm64-Release"
    }
  ],
  "testPresets": [
    {
      "name": "arm64-Debug",
      "displayName": "arm64 Debug Test",
      "configurePreset": "arm64-Debug"
    },
    {
      "name": "arm64-Release",
      "displayName": "arm64 Release Test",
      "configurePreset": "arm64-Release"
    }
  ]
}
